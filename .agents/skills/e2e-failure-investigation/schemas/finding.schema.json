{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "finding.schema.json",
  "title": "E2E investigation finding",
  "type": "object",
  "required": ["facts", "hypothesis", "confidence", "evidence", "gaps"],
  "properties": {
    "facts": {
      "type": "object",
      "required": ["test", "platform", "environment", "run", "job", "outcome", "first_error"],
      "properties": {
        "test": { "type": "string" },
        "platform": { "enum": ["desktop", "ios", "android"] },
        "device": { "type": ["string", "null"] },
        "environment": { "enum": ["testing", "production"] },
        "run": { "type": "integer" },
        "job": { "type": "integer" },
        "file": { "type": ["string", "null"] },
        "line": { "type": ["integer", "null"] },
        "failing_step": { "type": ["string", "null"] },
        "first_error": { "type": "string" },
        "outcome": { "enum": ["failed", "flaky"] },
        "retried": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "hypothesis": {
      "type": "object",
      "required": ["cause_id", "cause", "verdict", "area"],
      "properties": {
        "cause_id": { "type": "string", "description": "Stable slug for the same cause across runs" },
        "cause": { "type": "string" },
        "verdict": { "enum": ["bug", "test_adjustment"] },
        "area": { "enum": ["product", "backend", "test", "infra"] }
      },
      "additionalProperties": false
    },
    "confidence": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["confirmed", "known", "not_confirmed"] },
        "ticket": { "type": ["object", "null"], "properties": { "key": { "type": "string" }, "created_by_agent": { "type": "boolean" } }, "additionalProperties": false },
        "prd": { "type": "object", "required": ["status"], "properties": { "status": { "enum": ["confirmed", "not_confirmed", "not_applicable", "not_checked"] }, "ref": { "type": "string" } }, "additionalProperties": false }
      },
      "additionalProperties": false
    },
    "evidence": { "type": "array", "items": { "type": "object", "required": ["kind", "ref"], "properties": { "kind": { "enum": ["log_line", "file_line", "pr_diff", "datadog", "network", "artifact"] }, "ref": { "type": "string" }, "quote": { "type": "string" } }, "additionalProperties": false } },
    "gaps": { "type": "object", "required": ["attempts", "user_actions"], "properties": { "attempts": { "type": "array", "items": { "type": "string" } }, "user_actions": { "type": "array", "items": { "type": "string" } } }, "additionalProperties": false }
  },
  "allOf": [
    { "if": { "properties": { "confidence": { "properties": { "status": { "const": "confirmed" } } } } }, "then": { "properties": { "evidence": { "minItems": 1 } } } },
    { "if": { "properties": { "confidence": { "properties": { "status": { "const": "known" } } } } }, "then": { "properties": { "confidence": { "required": ["ticket"] } } } }
  ],
  "additionalProperties": false
}
