{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "investigation-output.schema.json",
  "title": "E2E investigation output",
  "type": "object",
  "required": ["version", "run", "preflight", "findings", "summary"],
  "properties": {
    "version": { "const": "1" },
    "run": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": ["integer", "string"], "pattern": "^[0-9]+$" },
        "workflow": { "type": "string" },
        "branch": { "type": "string" },
        "head_sha": { "type": "string" },
        "environment": { "enum": ["testing", "production", "unknown"] }
      },
      "additionalProperties": false
    },
    "preflight": {
      "type": "object",
      "required": ["availability", "adapter", "environment", "policy"],
      "properties": {
        "availability": { "type": "object", "additionalProperties": { "enum": ["available", "unavailable", "not_requested"] } },
        "adapter": { "type": "object", "required": ["github_actions", "koda_mcp"], "properties": { "github_actions": { "type": "string" }, "koda_mcp": { "type": "string" } }, "additionalProperties": false },
        "environment": { "type": "object", "required": ["status"], "properties": { "status": { "enum": ["detected", "unknown"] }, "value": { "enum": ["testing", "production", "unknown"] }, "sources": { "type": "array", "items": { "type": "string" } } }, "additionalProperties": false },
        "policy": { "type": "object", "required": ["collection", "jira_writes"], "properties": { "collection": { "enum": ["read_only_automatic"] }, "jira_writes": { "enum": ["requires_explicit_approval", "approved"] } }, "additionalProperties": false }
      },
      "additionalProperties": false
    },
    "findings": { "type": "array", "items": { "$ref": "finding.schema.json" } },
    "summary": { "type": "object", "required": ["failed", "flaky", "left_out"], "properties": { "failed": { "type": "integer", "minimum": 0 }, "flaky": { "type": "integer", "minimum": 0 }, "left_out": { "type": "integer", "minimum": 0 }, "skipped": { "enum": ["no_failures", "no_domain_failures"] } }, "additionalProperties": false },
    "gaps": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
