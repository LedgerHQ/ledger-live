{
  "_note": "Edited by owners only. The agent never changes this file.",
  "detection": {
    "order": ["log_swap_api_base", "log_firebase_env", "workflow_default"],
    "log_swap_api_base": {
      "pattern": "^\\s+SWAP_API_BASE: (https://[^\\s\"]+)",
      "match_against": "environments.*.swap_api_base"
    },
    "log_firebase_env": {
      "patterns": ["Firebase env to target:\\*{0,2}\\s*(\\w+)", "firebase_env=(\\w+)"]
    },
    "workflow_default": "testing"
  },
  "environments": {
    "testing": {
      "firebase_env": "testing",
      "swap_api_base": "https://global.api.stg.ledger-test.com/swap/v5",
      "swap_live_app": "stg",
      "ledger_sync": "STAGING",
      "datadog": { "env": "stg" }
    },
    "production": {
      "firebase_env": "production",
      "swap_api_base": "https://global.api.prd.ledger.com/swap/v5",
      "swap_live_app": "prd",
      "ledger_sync": "PROD",
      "datadog": { "env": "prd" }
    }
  },
  "fixed_hosts": {
    "countervalues": "https://global.api.prd.ledger.com/countervalue"
  },
  "known_env_mismatches": [
    {
      "id": "quote-probe-hardcoded-stg",
      "file": "libs/live-e2e-shared/src/swap.ts",
      "detail": "SWAP_QUOTE_URL is hard-coded to stg. On a production run the min amount probe queries the wrong env."
    }
  ]
}
