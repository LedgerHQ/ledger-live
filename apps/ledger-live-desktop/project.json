{
  "name": "ledger-live-desktop",
  "targets": {
    "build": {
      "cache": false,
      "inputs": ["default", "^default", "desktopEnv", "sharedEnv"]
    },
    "build:testing": {
      "cache": false,
      "dependsOn": ["^build"]
    },
    "build-lib-deps": {
      "executor": "nx:noop",
      "cache": true,
      "dependsOn": ["^build"]
    },
    "lint": {
      "inputs": [
        "default",
        "^default",
        {
          "env": "CI_OS"
        },
        { "externalDependencies": [] }
      ]
    },
    "test": {
      "dependsOn": ["build:testing"],
      "inputs": [
        "default",
        "^default",
        {
          "env": "CI_OS"
        },
        { "externalDependencies": [] }
      ]
    },
    "rsdoctor": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "cache": true,
      "outputs": ["{workspaceRoot}/rsdoctor/desktop-*/**"],
      "inputs": [
        "default",
        "!{projectRoot}/docs/**",
        "!{projectRoot}/fastlane/**",
        "!{projectRoot}/**/__tests__/**",
        "!{projectRoot}/**/*.test.{ts,tsx,js}",
        "^default",
        "desktopEnv",
        "sharedEnv",
        { "env": "CI" },
        { "env": "DATADOG_APPLICATION_ID" },
        { "env": "DATADOG_CLIENT_TOKEN" },
        { "env": "DATADOG_ENV" },
        { "env": "DATADOG_SITE" },
        { "env": "NIGHTLY" },
        { "env": "STAGING" },
        { "env": "TESTING" }
      ],
      "options": {
        "cwd": "{projectRoot}",
        "command": "pnpm run build:js",
        "env": {
          "RSDOCTOR": "1"
        }
      }
    },
    "pack": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "cache": false,
      "inputs": ["default", "^default", "desktopEnv", "sharedEnv"],
      "options": {
        "cwd": "apps/ledger-live-desktop",
        "command": "node ./tools/dist pack"
      },
      "configurations": {
        "nightly": {
          "args": "--nightly"
        },
        "pre": {
          "args": "--pre"
        },
        "release": {
          "args": "--release"
        },
        "nightly-mas": {
          "args": "--nightly --mas"
        },
        "pre-mas": {
          "args": "--pre --mas"
        },
        "release-mas": {
          "args": "--release --mas"
        }
      }
    },
    "sign": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "apps/ledger-live-desktop",
        "command": "node ./tools/dist sign"
      },
      "configurations": {
        "nightly": {
          "args": "--nightly"
        },
        "pre": {
          "args": "--pre"
        },
        "release": {
          "args": "--release"
        },
        "nightly-mas": {
          "args": "--nightly --mas"
        },
        "pre-mas": {
          "args": "--pre --mas"
        },
        "release-mas": {
          "args": "--release --mas"
        }
      }
    }
  }
}
