{
  "name": "ledger-live-desktop",
  "targets": {
    "build": {
      "cache": false,
      "inputs": [
        "default",
        "^default",
        "desktopEnv",
        "sharedEnv"
      ]
    },
    "build:testing": {
      "cache": false,
      "dependsOn": [
        "^build"
      ]
    },
    "build-lib-deps": {
      "executor": "nx:noop",
      "dependsOn": [
        "^build"
      ]
    },
    "lint": {
      "inputs": [
        "default",
        "^default",
        {
          "env": "CI_OS"
        }
      ]
    },
    "test": {
      "dependsOn": [
        "build:testing"
      ],
      "inputs": [
        "default",
        "^default",
        {
          "env": "CI_OS"
        }
      ]
    },
    "pack": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "inputs": [
        "default",
        "^default",
        "desktopEnv",
        "sharedEnv"
      ],
      "options": {
        "cwd": "apps/ledger-live-desktop",
        "command": "node ./tools/dist pack"
      },
      "configurations": {
        "nightly": {
          "command": "node ./tools/dist pack --nightly"
        },
        "pre": {
          "command": "node ./tools/dist pack --pre"
        },
        "release": {
          "command": "node ./tools/dist pack --release"
        }
      }
    },
    "sign": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "apps/ledger-live-desktop",
        "command": "node ./tools/dist sign"
      },
      "configurations": {
        "nightly": {
          "command": "node ./tools/dist sign --nightly"
        },
        "pre": {
          "command": "node ./tools/dist sign --pre"
        },
        "release": {
          "command": "node ./tools/dist sign --release"
        }
      }
    }
  }
}