<?xml version="1.0" encoding="utf-8"?>
<!--
    Detox-only network security config. The detoxPreRelease build type is
    release-derived and only used for e2e prerelease validation, so it never
    reaches end users. Trusting user-installed CAs here lets a host-side proxy
    (e.g. mitmproxy) intercept HTTPS during e2e runs.
-->
<network-security-config>
    <base-config>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
