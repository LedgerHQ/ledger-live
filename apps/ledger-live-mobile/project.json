{
  "name": "live-mobile",
  "targets": {
    "lint": {
      "inputs": [
        "default",
        "^default",
        {
          "env": "CI_OS"
        }
      ]
    },
    "lint:ci": {
      "inputs": [
        "default",
        "^default",
        {
          "env": "CI_OS"
        }
      ]
    },
    "lint:i18n": {
      "inputs": [
        "default",
        "^default",
        {
          "env": "CI_OS"
        }
      ]
    },
    "e2e:ci": {
      "dependsOn": ["^build"],
      "cache": true,
      "outputs": [
        "{projectRoot}/artifacts/**",
        "{workspaceRoot}/e2e/mobile/artifacts/**",
        "{projectRoot}/main.jsbundle",
        "{projectRoot}/build/**",
        "{projectRoot}/ios/build/**",
        "{projectRoot}/android/app/build/**"
      ],
      "inputs": [
        "default",
        "^default",
        "mobileEnv",
        "sharedEnv",
        {
          "env": "RUNNER_OS"
        },
        "{workspaceRoot}/e2e/mobile/detox.config.js",
        "{workspaceRoot}/e2e/mobile/scripts/**"
      ]
    },
    "e2e:bundle": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "cache": true,
      "outputs": ["{projectRoot}/main.jsbundle"],
      "inputs": [
        "default",
        "!{projectRoot}/ios/**",
        "!{projectRoot}/android/**",
        "!{projectRoot}/fastlane/**",
        "!{projectRoot}/docs/**",
        "!{projectRoot}/**/*.md",
        "!{projectRoot}/**/__tests__/**",
        "!{projectRoot}/**/__integrations__/**",
        "!{projectRoot}/**/*.test.{ts,tsx,js}",
        "^default",
        "sharedEnv",
        {
          "env": "ENVFILE"
        },
        {
          "env": "NODE_ENV"
        }
      ],
      "options": {
        "cwd": "{projectRoot}",
        "env": {
          "DETOX": "1"
        }
      },
      "configurations": {
        "ios": {
          "command": "pnpm bundle:ios --dev false --minify false"
        },
        "android": {
          "command": "pnpm bundle:android --dev false --minify false"
        }
      }
    },
    "build": {
      "executor": "nx:noop"
    },
    "build-lib-deps": {
      "executor": "nx:noop",
      "dependsOn": [
        "^build"
      ]
    },
    "android:apk": {
      "outputs": [
        "{projectRoot}/android/app/build/generated/**",
        "{projectRoot}/android/app/build/intermediates/**"
      ],
      "inputs": [
        "default",
        "^default",
        "mobileEnv",
        "sharedEnv"
      ]
    },
    "ios:ci:adhoc": {
      "outputs": [
        "{projectRoot}/ios/build/**"
      ],
      "inputs": [
        "default",
        "^default",
        "mobileEnv",
        "sharedEnv"
      ]
    },
    "ios:local:ipa": {
      "outputs": [
        "{projectRoot}/ios/build/**"
      ],
      "inputs": [
        "default",
        "^default",
        "mobileEnv",
        "sharedEnv"
      ]
    }
  }
}