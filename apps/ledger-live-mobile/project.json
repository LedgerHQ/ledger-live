{
  "name": "live-mobile",
  "namedInputs": {
    "nativeBuild": [
      "{projectRoot}/.env.mock",
      "{projectRoot}/.env.mock.prerelease",
      "{projectRoot}/app.json",
      "{projectRoot}/react-native.config.js",
      "{projectRoot}/Gemfile",
      "{projectRoot}/Gemfile.lock",
      "{projectRoot}/scripts/e2e-ci.mjs",
      "{projectRoot}/scripts/native-deps.mjs",
      "{workspaceRoot}/e2e/mobile/detox.config.js",
      "{workspaceRoot}/e2e/mobile/scripts/syncAppVersion.js",
      "{workspaceRoot}/patches/react-native*.patch",
      "{workspaceRoot}/patches/detox@*.patch",
      "{workspaceRoot}/patches/expo*.patch",
      "{workspaceRoot}/patches/@callstack__repack*.patch",
      "{workspaceRoot}/libs/ui/packages/native/src/assets/fonts/**",
      {
        "runtime": "node apps/ledger-live-mobile/scripts/native-deps.mjs"
      }
    ]
  },
  "targets": {
    "lint": {
      "inputs": [
        "default",
        "^default",
        {
          "env": "CI_OS"
        }
      ]
    },
    "lint:ci": {
      "inputs": [
        "default",
        "^default",
        {
          "env": "CI_OS"
        }
      ]
    },
    "lint:i18n": {
      "inputs": [
        "default",
        "^default",
        {
          "env": "CI_OS"
        }
      ]
    },
    "e2e:ci": {
      "dependsOn": [
        "^build",
        "@ledgerhq/dummy-live-app:build",
        "@ledgerhq/dummy-wallet-app:build",
        "@ledgerhq/dummy-ptx-app:build"
      ],
      "cache": true,
      "outputs": [
        "{projectRoot}/artifacts/**",
        "{workspaceRoot}/e2e/mobile/artifacts/**",
        "{projectRoot}/main.jsbundle",
        "{projectRoot}/build/**",
        "{projectRoot}/ios/build/**",
        "{projectRoot}/android/app/build/**"
      ],
      "inputs": [
        "default",
        "^default",
        "mobileEnv",
        "sharedEnv",
        {
          "env": "RUNNER_OS"
        },
        "{workspaceRoot}/e2e/mobile/detox.config.js",
        "{workspaceRoot}/e2e/mobile/scripts/**"
      ]
    },
    "e2e:native:ios": {
      "executor": "nx:run-commands",
      "dependsOn": ["@ledgerhq/native-ui:build"],
      "cache": true,
      "inputs": [
        "nativeBuild",
        "{projectRoot}/ios/**",
        "!{projectRoot}/ios/build/**",
        "!{projectRoot}/ios/Pods/**"
      ],
      "outputs": [
        "{projectRoot}/ios/build/Build/Products/Release-iphonesimulator"
      ],
      "options": {
        "cwd": "{projectRoot}",
        "command": "pnpm e2e:ci -p ios -b"
      }
    },
    "e2e:native:android": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "nativeBuild",
        "{projectRoot}/android/**",
        "!{projectRoot}/android/build/**",
        "!{projectRoot}/android/app/build/**"
      ],
      "outputs": [
        "{projectRoot}/android/app/build/outputs/apk"
      ],
      "options": {
        "cwd": "{projectRoot}",
        "command": "pnpm e2e:ci -p android -b"
      }
    },
    "e2e:bundle": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "cache": true,
      "outputs": ["{projectRoot}/main.jsbundle"],
      "inputs": [
        "default",
        "!{projectRoot}/ios/**",
        "!{projectRoot}/android/**",
        "!{projectRoot}/fastlane/**",
        "!{projectRoot}/docs/**",
        "!{projectRoot}/**/*.md",
        "!{projectRoot}/**/__tests__/**",
        "!{projectRoot}/**/__integrations__/**",
        "!{projectRoot}/**/*.test.{ts,tsx,js}",
        "^default",
        "sharedEnv",
        {
          "env": "ENVFILE"
        },
        {
          "env": "NODE_ENV"
        }
      ],
      "options": {
        "cwd": "{projectRoot}",
        "env": {
          "DETOX": "1"
        }
      },
      "configurations": {
        "ios": {
          "command": "pnpm bundle:ios --dev false --minify false"
        },
        "android": {
          "command": "pnpm bundle:android --dev false --minify false"
        }
      }
    },
    "build": {
      "executor": "nx:noop"
    },
    "build-lib-deps": {
      "executor": "nx:noop",
      "dependsOn": [
        "^build"
      ]
    },
    "android:apk": {
      "outputs": [
        "{projectRoot}/android/app/build/generated/**",
        "{projectRoot}/android/app/build/intermediates/**"
      ],
      "inputs": [
        "default",
        "^default",
        "mobileEnv",
        "sharedEnv"
      ]
    },
    "ios:ci:adhoc": {
      "outputs": [
        "{projectRoot}/ios/build/**"
      ],
      "inputs": [
        "default",
        "^default",
        "mobileEnv",
        "sharedEnv"
      ]
    },
    "ios:local:ipa": {
      "outputs": [
        "{projectRoot}/ios/build/**"
      ],
      "inputs": [
        "default",
        "^default",
        "mobileEnv",
        "sharedEnv"
      ]
    }
  }
}