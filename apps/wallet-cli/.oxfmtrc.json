{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "trailingComma": "all",
  "arrowParens": "avoid",
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/*.md",
    "package.json",
    "**/*.json",
    "dist/**",
    ".bunli/commands.gen.ts",
    "src/skills/manifest.gen.ts"
  ]
}
