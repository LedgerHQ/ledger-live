{
  "name": "@ledgerhq/wallet-cli",
  "version": "2.9.0",
  "private": true,
  "description": "Ledger Wallet CLI using Device Management Kit (USB)",
  "license": "Apache-2.0",
  "bin": {
    "wallet-cli": "./bin/wallet-cli"
  },
  "files": [
    "bin/",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "CHANGELOG.md",
    "package.json"
  ],
  "type": "module",
  "scripts": {
    "prestart": "pnpm generate:skills",
    "start": "bun run ./src/cli.ts",
    "apdu-proxy": "bun run ./src/apdu-proxy.ts",
    "predev": "node ./scripts/generate-skills-manifest.mjs",
    "dev": "bun --hot ./src/cli.ts",
    "generate:skills": "node ./scripts/generate-skills-manifest.mjs",
    "prebuild": "node ./scripts/generate-skills-manifest.mjs",
    "build": "node ./scripts/build.mjs",
    "prepare:npm": "node ./scripts/prepare-npm.mjs",
    "check:notices": "node ./scripts/check-third-party-notices.mjs",
    "check:skills": "node ./scripts/generate-skills-manifest.mjs --check",
    "pack:check": "node ./scripts/pack-check.mjs",
    "smoke:npm": "node ./scripts/smoke-npm.mjs",
    "pretypecheck": "node ./scripts/generate-skills-manifest.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "node ./scripts/generate-skills-manifest.mjs",
    "test": "bun test src/ scripts/",
    "coverage": "bun test src/ scripts/ --coverage",
    "lint": "oxlint .",
    "lint:ci": "oxlint . --quiet",
    "lint:fix": "oxfmt . && oxlint . --fix --quiet",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check"
  },
  "optionalDependencies": {
    "@ledgerhq/wallet-cli-darwin-arm64": "workspace:*",
    "@ledgerhq/wallet-cli-linux-arm64": "workspace:*",
    "@ledgerhq/wallet-cli-linux-x64": "workspace:*",
    "@ledgerhq/wallet-cli-windows-x64": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@bunli/core": "0.9.1",
    "@bunli/utils": "0.6.0",
    "@domain/api-swap-quotes": "workspace:^",
    "@domain/entity-account-descriptor": "workspace:^",
    "@domain/entity-currency": "workspace:^",
    "@domain/entity-currency-crypto": "workspace:^",
    "@domain/entity-currency-fiat": "workspace:^",
    "@domain/entity-currency-token": "workspace:^",
    "@domain/entity-currency-unit": "workspace:^",
    "@features/platform-currencies": "workspace:^",
    "@ledgerhq/agent-intent-sdk": "file:vendor/ledgerhq-agent-intent-sdk-0.0.0.tgz",
    "@ledgerhq/auth": "catalog:",
    "@ledgerhq/coin-bitcoin": "workspace:^",
    "@ledgerhq/coin-evm": "catalog:",
    "@ledgerhq/coin-module-framework": "catalog:",
    "@ledgerhq/coin-solana": "workspace:^",
    "@ledgerhq/context-module": "catalog:",
    "@features/platform-device-intent": "workspace:^",
    "@ledgerhq/device-management-kit": "catalog:",
    "@ledgerhq/device-signer-kit-ethereum": "catalog:",
    "@ledgerhq/hw-app-exchange": "workspace:^",
    "@ledgerhq/hw-ledger-key-ring-protocol": "catalog:",
    "@ledgerhq/hw-transport": "catalog:",
    "@ledgerhq/ledger-key-ring-protocol": "catalog:",
    "@ledgerhq/ledger-wallet-framework": "workspace:^",
    "@ledgerhq/live-common": "workspace:^",
    "@ledgerhq/live-config": "catalog:",
    "@ledgerhq/live-dmk-shared": "workspace:^",
    "@ledgerhq/live-wallet": "workspace:^",
    "@ledgerhq/logs": "catalog:",
    "@ledgerhq/types-devices": "workspace:*",
    "@ledgerhq/types-live": "workspace:^",
    "@napi-rs/keyring": "1.3.0",
    "@noble/hashes": "catalog:",
    "@reduxjs/toolkit": "catalog:",
    "@segment/analytics-node": "3.1.0",
    "@shared/analytics": "workspace:*",
    "@shared/api-services": "workspace:^",
    "@shared/auth": "workspace:^",
    "@shared/cloud-sync": "workspace:*",
    "@shared/env": "workspace:*",
    "@shared/schema-primitives": "workspace:^",
    "@types/debug": "4.1.12",
    "@types/node": "catalog:",
    "@types/w3c-web-usb": "^1.0.10",
    "axios": "catalog:",
    "bignumber.js": "catalog:",
    "bun-types": "1.4.2",
    "debug": "4.4.3",
    "fetch-cookie": "3.2.0",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "purify-ts": "2.1.0",
    "react": "catalog:",
    "react-redux": "catalog:",
    "rxjs": "catalog:",
    "typescript": "catalog:",
    "usb": "2.17.0",
    "xstate": "catalog:",
    "yocto-spinner": "0.2.0",
    "zod": "catalog:"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
