{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["../../support/lint/restricted-imports/wallet-cli.json"],
  "env": {
    "es6": true,
    "node": true
  },
  "plugins": ["eslint", "import", "oxc", "unicorn", "typescript"],
  "ignorePatterns": [
    "*.js",
    "*.cjs",
    "*.mjs",
    "node_modules",
    "dist/**",
    "src/skills/manifest.gen.ts"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "pedantic": "off"
  },
  "rules": {
    "eslint/no-unused-vars": "warn",
    "eslint/no-empty-pattern": "warn",
    "eslint/no-constant-binary-expression": "warn",
    "eslint/no-shadow": "off",
    "eslint/no-unused-expressions": "warn",
    "eslint/no-unsafe-optional-chaining": "off",
    "eslint/no-useless-rename": "warn",
    "eslint/no-console": "off",
    "import/no-duplicates": "error",
    "import/no-named-as-default": "off",
    "import/no-unassigned-import": "off",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "off",
    "typescript/no-deprecated": "error",
    "unicorn/no-useless-fallback-in-spread": "off",
    "unicorn/no-useless-spread": "off",
    "unicorn/no-new-array": "off",
    "unicorn/no-array-sort": "off",
    "oxc/const-comparisons": "warn"
  }
}
