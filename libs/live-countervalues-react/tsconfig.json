{
  "extends": "@support/ts-preset/lib-react",
  "compilerOptions": {
    "noImplicitAny": true,
    "noImplicitThis": true,
    "lib": [
      "es2020",
      "dom"
    ],
    "types": [
      "node",
      "jest"
    ],
    "paths": {
      "*": [
        "./*"
      ],
      "react": [
        "../../node_modules/@types/react"
      ],
      "@types/react": [
        "../../node_modules/@types/react"
      ]
    }
  }
}
