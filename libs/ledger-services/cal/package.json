{
  "name": "@ledgerhq/ledger-cal-service",
  "version": "1.19.12",
  "private": true,
  "description": "Ledger CAL service client",
  "keywords": [
    "Ledger",
    "Services",
    "CAL",
    "cal"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/LedgerHQ/ledger-live.git"
  },
  "bugs": {
    "url": "https://github.com/LedgerHQ/ledger-live/issues"
  },
  "homepage": "https://github.com/LedgerHQ/ledger-live/tree/develop/libs/ledger-service/cal",
  "exports": {
    "./*": "./src/*.ts",
    "./*.js": "./src/*.ts",
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@ledgerhq/live-network": "catalog:",
    "@shared/env": "workspace:*"
  },
  "devDependencies": {
    "@ledgerhq/test-quarantine": "workspace:*",
    "@swc/core": "catalog:",
    "@swc/jest": "catalog:",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:",
    "axios": "catalog:",
    "dotenv": "16.4.7",
    "expect": "catalog:",
    "jest": "catalog:",
    "msw": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "rimraf": "catalog:"
  },
  "scripts": {
    "coverage": "jest --coverage --passWithNoTests",
    "lint": "oxlint ./src",
    "lint:fix": "pnpm exec oxfmt ./src && oxlint ./src --fix --quiet",
    "format": "pnpm exec oxfmt ./src",
    "format:check": "pnpm exec oxfmt ./src --check",
    "typecheck": "tsc --noEmit --customConditions node",
    "test": "jest",
    "test-integ": "DOTENV_CONFIG_PATH=.env.integ.test jest --config=jest.integ.config.js"
  }
}
