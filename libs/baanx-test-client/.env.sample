# Baanx test-user credentials for @ledgerhq/baanx-test-auth.
#
# Copy to .env (gitignored) and fill in. Never commit real values.
# The library reads process.env — load this file with your runner's own
# mechanism (e.g. `set -a; source .env; set +a`, or dotenv in globalSetup).

# --- Required ---

# Baanx x-client-key. Sandbox needs its OWN key; the app's CARD_BAANX_CLIENT_KEY
# value is not valid here.
BAANX_CLIENT_KEY=""

BAANX_TEST_USER_EMAIL=""

# Not trimmed — trailing whitespace is preserved in case it is significant.
BAANX_TEST_USER_PASSWORD=""

# Authenticator setup key, base32. Spaces, dashes, padding and lower case are
# all accepted. This is a credential: treat it like the password.
BAANX_TEST_USER_TOTP_SECRET=""

# --- Optional ---

# Defaults to https://dev.api.baanx.com
#BAANX_API_BASE_URL=""

# "international" (default) or "us". "us" sends x-us-env: true.
#BAANX_TEST_USER_REGION="international"

# Standard TOTP parameters; override only if the user was enrolled differently.
#BAANX_TOTP_DIGITS="6"
#BAANX_TOTP_PERIOD="30"
#BAANX_TOTP_ALGORITHM="SHA1"
