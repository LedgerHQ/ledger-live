{
  "extends": "@support/ts-libs",
  "compilerOptions": {
    "noImplicitAny": true,
    "noImplicitThis": true,
    "jsx": "react",
    "lib": [
      "es2020",
      "dom"
    ],
    "outDir": "lib",
    "rootDir": "src",
    "paths": {
      "*": [
        "./*"
      ],
      "react": [
        "../../node_modules/@types/react"
      ],
      "@types/react": [
        "../../node_modules/@types/react"
      ]
    },
    "types": [
      "node",
      "jest"
    ]
  }
}
