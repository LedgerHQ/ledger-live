{
  "name": "@ledgerhq/native-ui",
  "version": "0.66.0",
  "description": "Ledger Live - Mobile UI",
  "repository": {
    "type": "git",
    "url": "https://github.com/LedgerHQ/ledger-live.git"
  },
  "bugs": {
    "url": "https://github.com/LedgerHQ/ledger-live/issues"
  },
  "homepage": "https://github.com/LedgerHQ/ledger-live/tree/develop/libs/ui/packages/native",
  "license": "MIT",
  "author": "Ledger Wallet Team <team-live@ledger.fr>",
  "main": "lib/index.js",
  "types": "index.d.ts",
  "typesVersions": {
    "*": {
      "*": [
        "lib/*",
        "lib/*/index.d.ts",
        "./*"
      ]
    }
  },
  "exports": {
    ".": {
      "@ledgerhq/source": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./lib/*": "./lib/*.js",
    "./lib/*/": "./lib/*/index.js",
    "./pre-ldls": {
      "@ledgerhq/source": "./src/pre-ldls/index.ts",
      "default": "./lib/pre-ldls/index.js"
    },
    "./assets/icons": {
      "@ledgerhq/source": "./src/assets/icons.ts",
      "default": "./lib/assets/icons.js"
    },
    "./*": {
      "@ledgerhq/source": [
        "./src/*.ts",
        "./src/*.tsx"
      ],
      "default": "./lib/*.js"
    },
    "./*/": {
      "@ledgerhq/source": [
        "./src/*/index.ts",
        "./src/*/index.tsx"
      ],
      "default": "./lib/*/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.prod.json && node scripts/postBuild",
    "watch": "tsc -p tsconfig.prod.json --watch",
    "clean": "rimraf lib",
    "lint": "oxlint -c ../../.oxlintrc.json ./src",
    "lint:fix": "pnpm lint --fix",
    "lint:css": "stylelint './src/**/*.{js,jsx,ts,tsx}'",
    "format": "oxfmt ./src",
    "format:check": "oxfmt --check ./src",
    "release": "yarn publish ./lib --access public",
    "typecheck": "tsc --noEmit -p tsconfig.json  --customConditions node",
    "test": "exit 0",
    "unimported": "pnpm knip --directory ../../../.. -W libs/ui/packages/native"
  },
  "dependencies": {
    "@ledgerhq/icons-ui": "workspace:^",
    "@ledgerhq/ui-shared": "workspace:^",
    "color": "^4.0.0",
    "styled-system": "catalog:"
  },
  "peerDependencies": {
    "react": ">=17",
    "react-native": ">=0.64.0",
    "react-native-reanimated": ">=4.1",
    "react-native-worklets": ">=0.7",
    "react-native-safe-area-context": ">=5.5.2",
    "react-native-svg": ">=12.1.1",
    "styled-components": ">=6.0.0"
  },
  "devDependencies": {
    "@babel/core": "7.28.5",
    "@babel/generator": "7.28.5",
    "@babel/plugin-transform-arrow-functions": "7.27.1",
    "@babel/plugin-transform-class-properties": "7.27.1",
    "@babel/plugin-transform-export-namespace-from": "7.27.1",
    "@babel/plugin-transform-nullish-coalescing-operator": "7.27.1",
    "@babel/plugin-transform-optional-chaining": "7.28.5",
    "@babel/plugin-transform-shorthand-properties": "7.27.1",
    "@babel/plugin-transform-template-literals": "7.27.1",
    "@babel/preset-env": "7.28.5",
    "@babel/runtime": "7.28.4",
    "@emotion/core": "^11.0.0",
    "@emotion/native": "^11.0.0",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-community/cli-server-api": "^7.0.3",
    "@react-native-community/datetimepicker": "6.7.5",
    "@react-native-community/slider": "^4.5.7",
    "@react-native/assets-registry": "catalog:",
    "@react-native/babel-preset": "catalog:",
    "@svgr/core": "^5.5.0",
    "@svgr/plugin-jsx": "^5.5.0",
    "@svgr/plugin-svgo": "^5.5.0",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/user-event": "14.5.2",
    "@types/color": "^3.0.3",
    "@types/hoist-non-react-statics": "^3.3.1",
    "@types/lodash": "catalog:",
    "@types/node": "catalog:",
    "@types/prop-types": "^15.7.5",
    "@types/react": "catalog:",
    "@types/styled-system": "^5.1.13",
    "babel-loader": "10.0.0",
    "babel-plugin-module-resolver": "5.0.2",
    "babel-plugin-react-docgen-typescript": "^1.5.1",
    "buffer": "6.0.3",
    "camelcase": "^6.2.1",
    "csstype": "^3.0.11",
    "oxlint": "catalog:",
    "oxfmt": "catalog:",
    "fs-extra": "^10.0.1",
    "glob": "^7.2.0",
    "lodash": "catalog:",
    "minimatch": "^5.1.0",
    "prop-types": "^15.8.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-is": "19.0.0",
    "react-native": "catalog:",
    "react-native-reanimated": "catalog:",
    "react-native-worklets": "catalog:",
    "react-native-safe-area-context": "catalog:",
    "react-native-svg": "catalog:",
    "regenerator-runtime": "^0.14.0",
    "rimraf": "^4.4.1",
    "styled-components": "catalog:",
    "stylelint": "^14.9.1",
    "stylelint-config-recommended": "^13.0.0",
    "stylelint-config-styled-components": "^0.1.1",
    "stylelint-processor-styled-components": "^1.10.0",
    "util": "^0.12.5",
    "react-refresh": "catalog:"
  }
}
