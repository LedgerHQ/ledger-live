{
  "compilerOptions": {
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "composite": true,
    "customConditions": ["react-native"],
    "declarationMap": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "ESNext"],
    "module": "preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "noEmit": true,
    "paths": { "*": ["./*"] },
    "preserveSymlinks": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext",
    "types": [
      "react",
      "react-native"
    ]
  },
  "include": ["src/**/*"],
  "exclude": [
    ".expo",
    ".expo-shared",
    "scripts",
    "assets",
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js",
    "lib"
  ]
}
