{
  "extends": "../../../../tsconfig.base",
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "jsx": "react",
    "lib": ["es2019", "dom"],
    "types": [],
    "paths": { "*": ["./*"] },
    "rootDir": "./src",
    "outDir": "./lib",
    "preserveSymlinks": true,
    "moduleResolution": "bundler",
    "module": "ESNext"
  },
  "include": ["src/**/*", "types.d.ts"],
  "exclude": ["node_modules", "./scripts", "./lib"]
}
