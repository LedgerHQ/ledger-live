{
  "extends": "@support/tsconfig/logic",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "jsx": "react",
    "rootDir": "./src",
    "outDir": ".",
    "paths": {
      "*": ["./*"],
      "react": ["../../../../node_modules/@types/react"],
      "@types/react": ["../../../../node_modules/@types/react"]
    },
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable",
      "DOM.AsyncIterable",
      "ScriptHost",
      "WebWorker.ImportScripts"
    ]
  }
}
