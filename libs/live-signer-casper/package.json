{
  "name": "@ledgerhq/live-signer-casper",
  "version": "0.0.0",
  "private": true,
  "sideEffects": false,
  "description": "Ledger Hardware Wallet Casper Application API",
  "keywords": [
    "Ledger",
    "LedgerWallet",
    "casper",
    "cspr",
    "Hardware Wallet"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/LedgerHQ/ledger-live.git"
  },
  "bugs": {
    "url": "https://github.com/LedgerHQ/ledger-live/issues"
  },
  "homepage": "https://github.com/LedgerHQ/ledger-live/tree/develop/libs/live-signer-casper",
  "publishConfig": {
    "access": "public"
  },
  "main": "lib/index.js",
  "module": "lib-es/index.js",
  "types": "lib-es/index.d.ts",
  "license": "Apache-2.0",
  "dependencies": {
    "@ledgerhq/coin-casper": "workspace:^",
    "@ledgerhq/device-management-kit": "catalog:",
    "@ledgerhq/device-signer-kit-casper": "file:../../../local-packs/ledgerhq-device-signer-kit-casper-0.1.0.tgz",
    "@ledgerhq/hw-transport": "catalog:",
    "@ledgerhq/ledger-wallet-framework": "workspace:^",
    "@zondax/ledger-casper": "^2.6.1",
    "rxjs": "catalog:"
  },
  "scripts": {
    "clean": "rimraf lib lib-es",
    "build": "tsc --project tsconfig.build.json && tsc --project tsconfig.build.json -m esnext --moduleResolution bundler --outDir lib-es",
    "prewatch": "pnpm build",
    "watch": "tsc --watch",
    "watch:es": "tsc --watch -m esnext --moduleResolution bundler --outDir lib-es",
    "lint": "oxlint -c ../oxc-live-libs/.oxlintrc.json ./src",
    "lint:fix": "pnpm lint --fix",
    "typecheck": "tsc --noEmit --project tsconfig.build.json",
    "test": "jest",
    "coverage": "jest --coverage",
    "format": "oxfmt src tests",
    "format:check": "oxfmt --check src tests"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@ledgerhq/disable-network-setup": "workspace:^",
    "@ledgerhq/test-quarantine": "workspace:*",
    "@ledgerhq/types-live": "workspace:^",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "jest": "catalog:",
    "oxfmt": "catalog:",
    "rimraf": "^4.4.1",
    "@swc/jest": "catalog:",
    "@swc/core": "catalog:",
    "ts-node": "^10.4.0",
    "typescript": "catalog:"
  },
  "exports": {
    ".": {
      "@ledgerhq/source": "./src/index.ts",
      "import": "./lib-es/index.js",
      "require": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./lib-es/*": "./lib-es/*.js",
    "./lib/*": "./lib/*.js",
    "./package.json": "./package.json"
  }
}
