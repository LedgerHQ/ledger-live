{
  "name": "@ledgerhq/speculos-transport",
  "version": "0.13.0",
  "private": true,
  "description": "Ledger Live speculos transport test helper",
  "keywords": [
    "Ledger"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/LedgerHQ/ledger-live.git"
  },
  "bugs": {
    "url": "https://github.com/LedgerHQ/ledger-live/issues"
  },
  "homepage": "https://github.com/LedgerHQ/ledger-live/tree/develop/libs/speculos-transport",
  "license": "Apache-2.0",
  "dependencies": {
    "@ledgerhq/devices": "catalog:",
    "@ledgerhq/live-dmk-speculos": "workspace:*",
    "@ledgerhq/live-promise": "catalog:",
    "@ledgerhq/logs": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "rimraf": "catalog:"
  },
  "scripts": {
    "lint": "oxlint ./src",
    "lint:fix": "pnpm exec oxfmt ./src && oxlint ./src --fix --quiet",
    "format": "pnpm exec oxfmt ./src",
    "format:check": "pnpm exec oxfmt ./src --check",
    "typecheck": "tsc --noEmit --customConditions node"
  },
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts",
    "./package.json": "./package.json"
  }
}
