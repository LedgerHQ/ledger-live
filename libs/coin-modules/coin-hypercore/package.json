{
  "name": "@ledgerhq/coin-hypercore",
  "version": "0.1.0",
  "description": "HyperCore L1 coin integration (read-only)",
  "keywords": [
    "Ledger",
    "LedgerWallet",
    "hypercore",
    "hyperliquid",
    "Hardware Wallet"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/LedgerHQ/ledger-live.git"
  },
  "bugs": {
    "url": "https://github.com/LedgerHQ/ledger-live/issues"
  },
  "homepage": "https://github.com/LedgerHQ/ledger-live/tree/develop/libs/coin-modules/coin-hypercore",
  "publishConfig": {
    "access": "public"
  },
  "typesVersions": {
    "*": {
      "lib/*": [
        "lib/*"
      ],
      "lib-es/*": [
        "lib-es/*"
      ],
      "api": [
        "lib/api/index"
      ],
      "logic": [
        "lib/logic/index"
      ],
      "types": [
        "lib/types/index"
      ],
      "*": [
        "lib/*",
        "lib/api/*",
        "lib/bridge/*",
        "lib/logic/*",
        "lib/network/*",
        "lib/types/*"
      ]
    }
  },
  "exports": {
    "./lib/*": "./lib/*.js",
    "./lib-es/*": "./lib-es/*.js",
    "./api": {
      "@ledgerhq/source": "./src/api/index.ts",
      "require": "./lib/api/index.js",
      "default": "./lib-es/api/index.js"
    },
    "./logic": {
      "@ledgerhq/source": "./src/logic/index.ts",
      "require": "./lib/logic/index.js",
      "default": "./lib-es/logic/index.js"
    },
    "./types": {
      "@ledgerhq/source": "./src/types/index.ts",
      "require": "./lib/types/index.js",
      "default": "./lib-es/types/index.js"
    },
    "./config": {
      "@ledgerhq/source": "./src/config.ts",
      "require": "./lib/config.js",
      "default": "./lib-es/config.js"
    },
    "./transaction": {
      "@ledgerhq/source": "./src/bridge/transaction.ts",
      "require": "./lib/bridge/transaction.js",
      "default": "./lib-es/bridge/transaction.js"
    },
    "./*": {
      "@ledgerhq/source": "./src/*.ts",
      "require": "./lib/*.js",
      "default": "./lib-es/*.js"
    },
    ".": {
      "@ledgerhq/source": "./src/index.ts",
      "require": "./lib/index.js",
      "default": "./lib-es/index.js"
    },
    "./package.json": "./package.json"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@ledgerhq/coin-module-framework": "catalog:",
    "@ledgerhq/errors": "workspace:^",
    "@ledgerhq/ledger-wallet-framework": "workspace:^",
    "@ledgerhq/live-network": "workspace:^",
    "@ledgerhq/types-live": "workspace:^"
  },
  "devDependencies": {
    "@ledgerhq/disable-network-setup": "workspace:^",
    "@swc/core": "catalog:",
    "@swc/jest": "catalog:",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "expect": "catalog:",
    "jest": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  },
  "scripts": {
    "clean": "rimraf lib lib-es",
    "build": "tsc --project tsconfig.build.json && tsc --project tsconfig.build.json -m esnext --moduleResolution bundler --outDir lib-es",
    "coverage": "jest --coverage",
    "prewatch": "pnpm build",
    "watch": "tsc --watch --project tsconfig.build.json",
    "lint": "oxlint src",
    "lint:fix": "oxfmt src && oxlint src --fix --quiet",
    "test": "jest",
    "test-integ": "DOTENV_CONFIG_PATH=.env.integ.test jest --config=jest.integ.config.js --passWithNoTests",
    "typecheck": "tsc --noEmit --customConditions node",
    "format": "oxfmt src",
    "format:check": "oxfmt src --check"
  }
}
