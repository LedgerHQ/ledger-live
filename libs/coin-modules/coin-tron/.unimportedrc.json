{
  "ignoreUnresolved": [
    "@jest/expect-utils",
    "@jest/get-type",
    "jest-util"
  ],
  "entry": [
    "src/index.ts",
    "src/api/index.ts",
    "src/bridge/index.ts",
    "src/network/index.ts",
    "src/signer/index.ts"
  ],
  "ignoreUnimported": [
