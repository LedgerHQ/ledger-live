{
  "ignoreUnresolved": [
    "@jest/expect-utils",
    "@jest/get-type",
    "jest-util"
  ],
  "entry": [
    "src/index.ts",
    "src/api/index.ts",
    "src/network/index.ts"
  ],
  "ignoreUnimported": [
    "src/constants.ts",
    "src/supportedFeatures.ts"
  ],
  "ignorePatterns": [
    "**/node_modules/**",
    "**/*.fixture.ts",
    "**/*.mock.ts",
    "**/*.test.ts"
  ],
  "ignoreUnused": [
    "invariant"
  ]
}
