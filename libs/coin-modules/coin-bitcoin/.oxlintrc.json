{
  "$schema": "../../../node_modules/oxlint/configuration_schema.json",
  "extends": ["../.oxlintrc.json"],
  "rules": {
    "import/no-cycle": "warn"
  },
  "overrides": [
    {
      "files": ["src/api/**", "src/logic/**", "src/network/**"],
      "rules": {
        "eslint/no-restricted-imports": [
          "warn",
          {
            "patterns": [
              {
                "group": [
                  "@ledgerhq/**",
                  "!@ledgerhq/logs",
                  "!@ledgerhq/logs/**",
                  "!@ledgerhq/live-network",
                  "!@ledgerhq/live-network/**",
                  "!@ledgerhq/coin-module-framework",
                  "!@ledgerhq/coin-module-framework/**",
                  "!@ledgerhq/ledger-wallet-framework",
                  "!@ledgerhq/ledger-wallet-framework/**",
                  "!@ledgerhq/wallet-btc/**",
                  "@ledgerhq/wallet-btc/index"
                ],
                "message": "The bitcoin API uses wallet-btc's pure entry points (address crypto, sizes, dust, picking strategies, ADR-065), never its index: it instantiates the process-wide wallet singleton."
              }
            ]
          }
        ]
      }
    }
  ]
}
