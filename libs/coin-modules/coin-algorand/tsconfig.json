{
  "extends": "@support/ts-libs",
  "compilerOptions": {
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "lib": [
      "es2020",
      "dom"
    ],
    "types": [
      "node",
      "jest"
    ],
    "outDir": "lib",
    "rootDir": "src",
    "exactOptionalPropertyTypes": true
  },
  "exclude": [
    "src/api/subscan.ts",
    "src/api/websocket.ts",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts"
  ]
}
