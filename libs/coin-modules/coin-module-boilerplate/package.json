{
  "name": "@ledgerhq/coin-module-boilerplate",
  "version": "6.1.0",
  "private": true,
  "description": "Boilerplate coin integration",
  "keywords": [
    "Ledger",
    "LedgerWallet",
    "boilerplate",
    "Hardware Wallet"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/LedgerHQ/ledger-live.git"
  },
  "bugs": {
    "url": "https://github.com/LedgerHQ/ledger-live/issues"
  },
  "homepage": "https://github.com/LedgerHQ/ledger-live/tree/develop/libs/coin-modules/coin-module-boilerplate",
  "exports": {
    "./api": "./src/api/index.ts",
    "./deviceTransactionConfig": "./src/bridge/deviceTransactionConfig.ts",
    "./signer": "./src/signer/index.ts",
    "./transaction": "./src/bridge/transaction.ts",
    "./types": "./src/types/index.ts",
    "./*": "./src/*.ts",
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@ledgerhq/coin-module-framework": "catalog:",
    "@ledgerhq/devices": "catalog:",
    "@ledgerhq/ledger-wallet-framework": "workspace:^",
    "@ledgerhq/live-network": "catalog:",
    "@ledgerhq/types-live": "workspace:^",
    "bignumber.js": "^9.1.2",
    "invariant": "^2.2.4",
    "rxjs": "catalog:"
  },
  "devDependencies": {
    "@ledgerhq/disable-network-setup": "workspace:^",
    "@ledgerhq/test-quarantine": "workspace:*",
    "@ledgerhq/wallet-framework-test-setup": "workspace:^",
    "@support/jest": "workspace:*",
    "@swc/core": "catalog:",
    "@swc/jest": "catalog:",
    "@types/invariant": "2.2.37",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "axios": "catalog:",
    "dotenv": "16.4.7",
    "expect": "catalog:",
    "jest": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:"
  },
  "scripts": {
    "coverage": "jest --coverage",
    "lint": "oxlint src",
    "lint:fix": "oxfmt src && oxlint src --fix --quiet",
    "test": "jest",
    "test-integ": "DOTENV_CONFIG_PATH=.env.integ.test jest --config=jest.integ.config.js --passWithNoTests",
    "typecheck": "tsc --noEmit --customConditions node",
    "format": "oxfmt src",
    "format:check": "oxfmt src --check"
  }
}
