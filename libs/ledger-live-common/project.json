{
  "targets": {
    "build": {
      "outputs": ["{projectRoot}/lib/**", "{projectRoot}/lib-es/**"],
      "inputs": [
        "default",
        "^default",
        "tsConfig",
        { "externalDependencies": ["@typescript/native", "rimraf"] }
      ]
    },
    "typecheck": {
      "dependsOn": ["build"],
      "inputs": ["default", {"env": "CI_OS"}]
    }
  }
}
