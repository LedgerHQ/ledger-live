{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "env": {
    "browser": true,
    "es6": true,
    "node": true
  },
  "globals": {
    "Atomics": "readonly",
    "SharedArrayBuffer": "readonly"
  },
  "settings": {
    "react": {
      "version": "19.0.0"
    }
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "pedantic": "off"
  },
  "plugins": ["eslint", "import", "oxc", "unicorn", "typescript", "react", "jest", "jsx-a11y"],
  "ignorePatterns": ["*.min.js", "src/families/*/types.js", "src/load/tokens/**"],
  "rules": {
    "eslint/no-unused-vars": "warn",
    "eslint/no-empty-pattern": "warn",
    "eslint/no-constant-binary-expression": "warn",
    "eslint/no-unused-expressions": "warn",
    "eslint/no-console": [
      "error",
      {
        "allow": ["warn", "error"]
      }
    ],
    "eslint/no-restricted-imports": [
      "error",
      {
        "paths": [
          "lodash",
          {
            "name": "@ledgerhq/ledger-wallet-framework/types",
            "importNames": [
              "CryptoCurrency",
              "TokenCurrency",
              "Currency",
              "Unit",
              "FiatCurrency",
              "ExplorerView",
              "CryptoCurrencyId",
              "TokenCurrencyId",
              "CryptoCurrencyIdSchema",
              "TokenCurrencyIdSchema"
            ],
            "message": "Wallet-framework currency types are for coin-modules. Import from @domain/entity-currency-* (unions from @domain/entity-currency)."
          },
          {
            "name": "@ledgerhq/ledger-wallet-framework/api",
            "importNames": [
              "CryptoCurrency",
              "TokenCurrency",
              "Currency",
              "Unit",
              "FiatCurrency",
              "ExplorerView",
              "CryptoCurrencyId",
              "TokenCurrencyId",
              "CryptoCurrencyIdSchema",
              "TokenCurrencyIdSchema"
            ],
            "message": "Wallet-framework currency types are for coin-modules. Import from @domain/entity-currency-* (unions from @domain/entity-currency)."
          }
        ],
        "patterns": [
          {
            "group": ["@ledgerhq/live-common/lib/**", "@ledgerhq/live-common/lib-es/**"],
            "message": "Please remove the /lib import from live-common import."
          },
          {
            "group": [
              "@ledgerhq/live-common/currencies",
              "@ledgerhq/live-common/currencies/index",
              "@ledgerhq/live-common/currencies/helpers"
            ],
            "importNamePattern": "^(listCryptoCurrencies|getCryptoCurrencyById|hasCryptoCurrencyId|findCryptoCurrency|findCryptoCurrencyById|findCryptoCurrencyByScheme|findCryptoCurrencyByKeyword|findCryptoCurrencyByTicker|listFiatCurrencies|findFiatCurrencyByTicker|getFiatCurrencyByTicker|hasFiatCurrencyTicker)$",
            "message": "Currency accessors are owned by the domain layer. Import crypto accessors from @domain/entity-currency-crypto and fiat accessors from @domain/entity-currency-fiat."
          },
          {
            "group": ["@ledgerhq/coin-*/api", "@ledgerhq/coin-*/api/*"],
            "importNamePattern": "^createApi$",
            "message": "Reach a coin module through getCoinModuleApi (bridge/generic-coin-framework/api), which applies the framework's withDefaults. Since a module may omit the capabilities its chain lacks, calling createApi directly yields an object with those methods missing, and the call fails at runtime with nothing failing at compile time. If a direct call is genuinely needed, add the file to the exemptions in this config and record in the PR why it cannot break."
          }
        ]
      }
    ],
    "import/no-duplicates": "error",
    "import/no-named-as-default": "off",
    "react/no-did-mount-set-state": "warn",
    "react/display-name": "off",
    "react/jsx-key": "warn",
    "react/globals": "warn",
    "react/immutability": "warn",
    "react/preserve-manual-memoization": "warn",
    "react/purity": "warn",
    "react/refs": "warn",
    "react/set-state-in-effect": "warn",
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "warn",
    "unicorn/no-useless-fallback-in-spread": "off",
    "unicorn/no-useless-spread": "off",
    "unicorn/no-new-array": "off",
    "unicorn/no-array-sort": "off",
    "unicorn/no-array-reverse": "off",
    "jest/no-conditional-expect": "warn",
    "jest/prefer-snapshot-hint": "warn",
    "jest/valid-expect-in-promise": "warn",
    "jest/expect-expect": "warn",
    "jest/require-to-throw-message": "warn",
    "jest/valid-title": "warn",
    "jest/no-disabled-tests": "warn",
    "jest/no-export": "off",
    "jest/valid-describe-callback": "warn",
    "jest/no-standalone-expect": "warn",
    "oxc/only-used-in-recursion": "off",
    "typescript/no-explicit-any": "warn",
    "typescript/no-namespace": [
      "error",
      {
        "allowDeclarations": true
      }
    ],
    "typescript/no-empty-function": "off",
    "typescript/no-deprecated": "error",
    "typescript/consistent-type-assertions": [
      "warn",
      {
        "assertionStyle": "never"
      }
    ],
    "jsx-a11y/no-autofocus": "off",
    "jsx-a11y/prefer-tag-over-role": "off",
    "jsx-a11y/anchor-is-valid": [
      "error",
      {
        "components": []
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/deviceSDK/tasks/genuineCheck.ts"],
      "rules": {
        "unicorn/no-empty-file": "off"
      }
    },
    {
      "files": ["**/*.test.{ts,tsx}", "**/__tests__/**"],
      "env": {
        "jest": true
      },
      "plugins": ["jest"],
      "rules": {
        "typescript/no-explicit-any": "warn",
        "eslint/no-console": "off",
        "eslint/no-restricted-imports": "off"
      }
    },
    {
      "files": [
        "src/families/*/coinModuleApi.ts",
        "src/families/evm/getTokenAllowance.ts",
        "src/families/tezos/bridge/api.ts",
        "src/families/canton/bridge/mock.ts"
      ],
      "rules": {
        "eslint/no-restricted-imports": "off"
      }
    }
  ]
}
