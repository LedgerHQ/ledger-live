{
  "name": "@ledgerhq/test-quarantine",
  "version": "0.1.0",
  "private": true,
  "description": "YAML-driven test quarantine (Playwright and Jest)",
  "keywords": ["Ledger", "playwright", "jest", "testing"],
  "main": "lib/index.js",
  "module": "lib-es/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "clean": "rimraf lib lib-es",
    "build": "tsc --project tsconfig.build.json && tsc --project tsconfig.build.json -m esnext --moduleResolution bundler --outDir lib-es",
    "test": "jest --passWithNoTests",
    "unimported": "unimported"
  },
  "dependencies": {
    "picomatch": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@playwright/test": "catalog:",
    "jest": "catalog:",
    "jest-environment-jsdom": "catalog:"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    },
    "jest": {
      "optional": true
    },
    "jest-environment-jsdom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@jest/reporters": "catalog:",
    "@playwright/test": "catalog:",
    "@swc/core": "catalog:",
    "@swc/jest": "catalog:",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "@types/picomatch": "4.0.0",
    "jest": "catalog:",
    "jest-environment-jsdom": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:"
  },
  "exports": {
    ".": {
      "@ledgerhq/source": "./src/index.ts",
      "import": "./lib-es/index.js",
      "require": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./playwright/fixture": {
      "@ledgerhq/source": "./src/playwright/fixture.ts",
      "import": "./lib-es/playwright/fixture.js",
      "require": "./lib/playwright/fixture.js",
      "default": "./lib/playwright/fixture.js"
    },
    "./playwright/reporter": {
      "@ledgerhq/source": "./src/playwright/reporter.ts",
      "import": "./lib-es/playwright/reporter.js",
      "require": "./lib/playwright/reporter.js",
      "default": "./lib/playwright/reporter.js"
    },
    "./jest/environment": {
      "@ledgerhq/source": "./src/jest/environment.ts",
      "import": "./lib-es/jest/environment.js",
      "require": "./lib/jest/environment.js",
      "default": "./lib/jest/environment.js"
    },
    "./jest/reporter": {
      "@ledgerhq/source": "./src/jest/reporter.ts",
      "import": "./lib-es/jest/reporter.js",
      "require": "./lib/jest/reporter.js",
      "default": "./lib/jest/reporter.js"
    },
    "./package.json": "./package.json"
  }
}
