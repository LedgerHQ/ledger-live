{
  "extends": [
    "./tsconfig.json",
    "@support/ts-preset/lib/build"
  ],
  "compilerOptions": {
    "types": [
      "node"
    ]
  },
  "exclude": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/__tests__/**/*",
    "**/tests/**/*",
    "**/__mocks__/**/*"
  ]
}
