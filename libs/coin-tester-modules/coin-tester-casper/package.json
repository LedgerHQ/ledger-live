    "@ledgerhq/live-config": "catalog:",
    "@ledgerhq/types-live": "workspace:^",
    "bignumber.js": "^9.1.2",
    "casper-js-sdk": "5.1.1",
    "chalk": "catalog:",
    "docker-compose": "^1.1.0",
    "msw": "catalog:",
    "rxjs": "catalog:"
  },
  "devDependencies": {
    "@ledgerhq/coin-module-framework": "catalog:",
    "@ledgerhq/wallet-framework-test-setup": "workspace:^",
    "@swc/core": "catalog:",
    "@swc/jest": "catalog:",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "jest": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "rimraf": "5.0.10",
    "typescript": "catalog:"
