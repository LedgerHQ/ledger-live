{
  "extends": "@support/ts-libs",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": [
      "es2022",
      "dom"
    ],
    "outDir": "lib",
    "rootDir": "src",
    "types": [
      "node",
      "jest"
    ],
    "typeRoots": [
      "node_modules/@types",
      "../../../../node_modules/@types"
    ],
    "composite": true
  },
  "include": [
    "src/**/*",
    "src/**/*.json"
  ]
}
