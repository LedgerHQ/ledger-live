{
  "name": "@ledgerhq/coin-tester-polkadot",
  "version": "1.22.0",
  "private": true,
  "description": "Ledger Polkadot Coin Tester",
  "main": "src/scenarii.test.ts",
  "keywords": [
    "Ledger",
    "LedgerWallet",
    "dot",
    "Polkadot",
    "Testing"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/LedgerHQ/ledger-live.git"
  },
  "bugs": {
    "url": "https://github.com/LedgerHQ/ledger-live/issues"
  },
  "homepage": "https://github.com/LedgerHQ/ledger-live/tree/develop/libs/coin-tester-modules/coin-tester-polkadot",
  "exports": {
    "./*": "./src/*.ts",
    "./package.json": "./package.json"
  },
  "license": "Apache-2.0",
  "scripts": {
    "lint": "oxlint src",
    "lint:fix": "oxfmt src && oxlint src --fix --quiet",
    "format": "oxfmt src",
    "format:check": "oxfmt src --check",
    "typecheck": "tsc --noEmit --customConditions node",
    "start": "pnpm jest --runTestsByPath src/*.test.ts --forceExit --runInBand"
  },
  "dependencies": {
    "@ledgerhq/coin-module-framework": "catalog:",
    "@ledgerhq/coin-polkadot": "workspace:^",
    "@ledgerhq/coin-tester": "workspace:^",
    "@ledgerhq/ledger-wallet-framework": "workspace:^",
    "@ledgerhq/types-live": "workspace:^",
    "@polkadot/api": "catalog:",
    "@polkadot/util-crypto": "catalog:",
    "bignumber.js": "^9.1.2",
    "expect": "catalog:"
  },
  "devDependencies": {
    "@ledgerhq/wallet-framework-test-setup": "workspace:^",
    "@polkadot/rpc-provider": "catalog:",
    "@polkadot/util": "catalog:",
    "@swc/core": "catalog:",
    "@swc/jest": "catalog:",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "jest": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:"
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:noop"
      }
    }
  }
}
