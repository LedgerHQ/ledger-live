+        // With the data directory bind-mounted, put the snapshot's bitcoin chain state in place
+        // here, on the host, before the container exists. Copying it into the running container
+        // instead (`boot_bitcoin_node_container`) races bitcoind: when bitcoind has already begun
+        // its own chain state, the stacks-node's snapshot no longer matches the blocks it serves
+        // ("Non-contiguous header"). The files are made world-readable and writable because
+        // bitcoind runs as uid 1000, not as the user running clarinet; a Linux host enforces that.
+        if devnet_config.bind_containers_volumes && !no_snapshot {
+            let bitcoin_snapshot = get_global_snapshot_dir().join("bitcoin").join("regtest");
+            if bitcoin_snapshot.exists() {
+                copy_directory(&bitcoin_snapshot, &bitcoind_data_path.join("regtest"), None)?;
+                let status = std::process::Command::new("chmod")
+                    .args(["-R", "a+rwX"])
+                    .arg(&bitcoind_data_path)
+                    .status()
+                    .map_err(|e| format!("Failed to run chmod on the bitcoin snapshot: {e}"))?;
+                if !status.success() {
+                    return Err(format!(
+                        "chmod of the bitcoin snapshot failed ({status}): {}",
+                        bitcoind_data_path.display()
+                    ));
+                }
+            }
+        }
