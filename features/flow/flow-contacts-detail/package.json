    "@features/flow-contacts-edit-contact": "workspace:^",
    "@features/platform-contacts": "workspace:^",
    "@ledgerhq/crypto-icons": "catalog:",
    "@shared/clipboard": "workspace:*",
    "@shared/i18n": "workspace:*",
    "@shared/ui-qr-code": "workspace:*",
    "@shared/ui-queued-bottom-sheet": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-native": ">=0.70.0",
    "react-native-safe-area-context": ">=4.0.0",
    "react-redux": ">=9.0.0",
    "@ledgerhq/lumen-ui-react": "catalog:",
    "@ledgerhq/lumen-ui-rnative": "catalog:"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    },
    "react-native-safe-area-context": {
      "optional": true
    },
    "@ledgerhq/lumen-ui-react": {
      "optional": true
    },
    "@ledgerhq/lumen-ui-rnative": {
      "optional": true
    }
  },
