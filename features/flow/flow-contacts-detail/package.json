{
  "name": "@features/flow-contacts-detail",
  "version": "0.5.0-next.0",
  "private": true,
  "description": "Shared Contact Detail flow for Desktop and Mobile",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./native": "./src/native/index.native.ts",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "format": "oxfmt src",
    "format:check": "oxfmt src --check",
    "lint": "oxlint ./src",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.native.json",
    "test": "jest",
    "coverage": "jest --coverage"
  },
  "dependencies": {
    "@domain/entity-contact": "workspace:*",
