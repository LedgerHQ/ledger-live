{
  "name": "@features/flow-pay-card-widget",
  "version": "0.1.0",
  "private": true,
  "description": "Card widget flow for Pay tab in Ledger Wallet",
  "main": "src/index.ts",
  "react-native": "src/index.native.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.native.ts",
      "default": "./src/index.ts"
    },
    "./state": "./src/state/index.ts",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "dependencies": {
    "@domain/api-card-management": "workspace:^",
    "@reduxjs/toolkit": "catalog:",
    "@shared/i18n": "workspace:*"
  },
  "scripts": {
    "format": "oxfmt src",
    "format:check": "oxfmt src --check",
    "lint": "oxlint src",
    "lint:ci": "oxlint src --quiet",
    "lint:fix": "oxfmt src && oxlint src --fix --quiet",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.native.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "coverage": "jest --coverage",
    "unimported": "pnpm knip --directory ../../.. -c features/flow/pay-card-widget/knip.web.config.mjs -W features/flow/pay-card-widget --tsConfig tsconfig.web.json && pnpm knip --directory ../../.. -c features/flow/pay-card-widget/knip.native.config.mjs -W features/flow/pay-card-widget --tsConfig tsconfig.native.json"
  },
  "devDependencies": {
    "@support/jest-features-flow": "workspace:*",
    "@ledgerhq/lumen-ui-react": "catalog:",
    "@swc/core": "catalog:",
    "@swc/jest": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/jest": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "jest": "catalog:",
    "jest-environment-jsdom": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-redux": "catalog:",
    "typescript": "catalog:"
  },
  "optionalDependencies": {
    "@oxlint/binding-darwin-arm64": "1.51.0",
    "@oxlint/binding-darwin-x64": "1.51.0",
    "@oxlint/binding-linux-x64-gnu": "1.51.0",
    "@oxlint/binding-win32-x64-msvc": "1.51.0"
  },
  "peerDependencies": {
    "@ledgerhq/lumen-ui-react": "catalog:",
    "react": "catalog:",
    "react-redux": "catalog:"
  },
  "peerDependenciesMeta": {
    "@ledgerhq/lumen-ui-react": {
      "optional": true
    }
  }
}
