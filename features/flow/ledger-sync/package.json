{
  "name": "@features/flow-ledger-sync",
  "version": "0.1.0",
  "private": true,
  "description": "The Ledger Sync journey: activation, pairing, instances, backup deletion",
  "main": "src/index.ts",
  "react-native": "src/index.native.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.native.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "lint": "oxlint src",
    "format": "oxfmt src",
    "format:check": "oxfmt src --check",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.native.json",
    "test": "jest",
    "coverage": "jest --coverage"
  },
  "dependencies": {
    "@domain/entity-key-ring": "workspace:^",
