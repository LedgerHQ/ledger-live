{
  "name": "@features/flow-contacts-edit-address",
  "version": "0.3.1",
  "private": true,
  "description": "Shared Edit address flow for Desktop and Mobile",
  "main": "src/index.ts",
  "react-native": "src/index.native.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.native.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "format": "fmt-base src",
    "format:check": "fmt-base src --check",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.native.json",
    "test": "jest",
    "coverage": "jest --coverage",
    "unimported": "pnpm knip --directory ../../.. -c features/flow/flow-contacts-edit-address/knip.web.config.mjs -W features/flow/flow-contacts-edit-address --tsConfig tsconfig.web.json && pnpm knip --directory ../../.. -c features/flow/flow-contacts-edit-address/knip.native.config.mjs -W features/flow/flow-contacts-edit-address --tsConfig tsconfig.native.json",
    "lint": "lint-features-flow src",
    "lint:fix": "lint-features-flow src --fix"
  },
  "dependencies": {
    "@domain/entity-contact": "workspace:*",
    "@features/platform-contacts": "workspace:^",
    "@shared/ui-queued-bottom-sheet": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-native": ">=0.70.0",
    "@ledgerhq/lumen-design-core": "catalog:",
    "@ledgerhq/lumen-ui-react": "catalog:",
    "@ledgerhq/lumen-ui-rnative": "catalog:"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    },
    "@ledgerhq/lumen-design-core": {
      "optional": true
    },
    "@ledgerhq/lumen-ui-react": {
      "optional": true
    },
    "@ledgerhq/lumen-ui-rnative": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ledgerhq/lumen-design-core": "catalog:",
    "@ledgerhq/lumen-ui-react": "catalog:",
    "@ledgerhq/lumen-ui-rnative": "catalog:",
    "@support/fmt-base": "workspace:*",
    "@support/jest-features-flow": "workspace:*",
    "@support/lint-features-flow": "workspace:*",
    "@support/ts-features-flow": "workspace:*",
    "@swc/core": "catalog:",
    "@swc/jest": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/react-native": "catalog:",
    "@types/jest": "catalog:",
    "@types/react": "catalog:",
    "jest": "catalog:",
    "jest-environment-jsdom": "catalog:",
    "oxfmt": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:",
    "react-test-renderer": "catalog:",
    "typescript": "catalog:"
  }
}
