{
  "name": "@features/flow-fear-and-greed",
  "version": "0.4.0",
  "private": true,
  "description": "Fear and Greed mood index shared across Ledger Wallet desktop and mobile",
  "main": "src/index.ts",
  "react-native": "src/index.native.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.native.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "format": "oxfmt src",
    "format:check": "oxfmt src --check",
    "lint": "oxlint src",
    "lint:ci": "oxlint src --quiet",
    "lint:fix": "oxfmt src && oxlint src --fix --quiet",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.native.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "coverage": "jest --coverage",
    "unimported": "pnpm knip --directory ../../.. -c features/flow/fear-and-greed/knip.web.config.mjs -W features/flow/fear-and-greed --tsConfig tsconfig.web.json && pnpm knip --directory ../../.. -c features/flow/fear-and-greed/knip.native.config.mjs -W features/flow/fear-and-greed --tsConfig tsconfig.native.json"
  },
  "dependencies": {
    "@domain/api-market-index-fear-and-greed": "workspace:*",
    "@domain/entity-market-index-fear-and-greed": "workspace:*",
    "@shared/analytics": "workspace:*",
    "@shared/i18n": "workspace:*",
    "@shared/ui-queued-bottom-sheet": "workspace:*"
  },
  "peerDependencies": {
    "@ledgerhq/lumen-ui-react": "catalog:",
    "@ledgerhq/lumen-ui-rnative": "catalog:",
    "react": ">=19.0.0",
    "react-native": ">=0.70.0",
    "react-native-safe-area-context": ">=4.0.0",
    "react-redux": "catalog:"
  },
  "peerDependenciesMeta": {
    "@ledgerhq/lumen-ui-react": {
      "optional": true
    },
    "@ledgerhq/lumen-ui-rnative": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-native-safe-area-context": {
      "optional": true
    },
    "react-redux": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ledgerhq/lumen-ui-react": "catalog:",
    "@ledgerhq/lumen-ui-rnative": "catalog:",
    "@support/jest": "workspace:*",
    "@swc/core": "catalog:",
    "@swc/jest": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/react-native": "catalog:",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jest": "catalog:",
    "jest-environment-jsdom": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:",
    "react-native-safe-area-context": "catalog:",
    "react-redux": "catalog:",
    "react-test-renderer": "catalog:",
    "typescript": "catalog:"
  }
}
