{
  "name": "@features/flow-fear-and-greed",
  "version": "0.3.0",
  "private": true,
  "description": "Fear & Greed UI helpers: level, color and translation-key mapping shared across desktop and mobile",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "coverage": "jest --coverage",
    "unimported": "pnpm knip --directory ../../.. -W features/flow/fear-and-greed",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix",
    "format": "fmt-base src",
    "format:check": "fmt-base src --check"
  },
  "dependencies": {},
  "devDependencies": {
    "@jest/globals": "catalog:",
    "@ledgerhq/test-quarantine": "workspace:*",
    "@support/fmt-base": "workspace:*",
    "@support/ts-features-flow": "workspace:*",
    "@swc/core": "catalog:",
    "@swc/jest": "catalog:",
    "@types/jest": "catalog:",
    "jest": "catalog:",
    "typescript": "catalog:"
  }
}
