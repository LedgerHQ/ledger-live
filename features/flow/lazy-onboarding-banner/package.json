{
  "name": "@features/flow-lazy-onboarding-banner",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-platform lazy onboarding banner decision, CTA and session state",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts",
