{
  "name": "@features/flow-pay-card-assets",
  "version": "0.3.0-next.0",
  "private": true,
  "description": "Pay Card linked-wallet assets list for Ledger Wallet",
  "main": "src/index.ts",
  "react-native": "src/index.native.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.native.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "format": "oxfmt src",
    "format:check": "oxfmt src --check",
    "lint": "oxlint src && pnpm lint:tailwind",
    "lint:ci": "oxlint src --quiet && pnpm lint:tailwind",
    "lint:fix": "oxfmt src && oxlint src --fix --quiet && pnpm lint:tailwind",
    "lint:tailwind": "eslint --no-eslintrc --no-error-on-unmatched-pattern -c .eslintrc.tailwind.js --ext .ts,.tsx 'src/**/*.web.{ts,tsx}'",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.native.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "coverage": "jest --coverage",
    "unimported": "pnpm knip --directory ../../.. -c features/flow/pay-card-assets/knip.web.config.mjs -W features/flow/pay-card-assets --tsConfig tsconfig.web.json && pnpm knip --directory ../../.. -c features/flow/pay-card-assets/knip.native.config.mjs -W features/flow/pay-card-assets --tsConfig tsconfig.native.json"
  },
  "dependencies": {
    "@domain/api-card-management": "workspace:^",
    "@domain/entity-currency": "workspace:^",
    "@features/flow-pay-card-auth": "workspace:^",
    "@features/flow-pay-card-transactions": "workspace:^",
    "@features/flow-pay-card-wallets": "workspace:^",
    "@features/platform-pay-analytics": "workspace:^",
    "@ledgerhq/crypto-icons": "catalog:",
    "@shared/i18n": "workspace:*",
    "@shared/ui-list-reorder": "workspace:*"
  },
  "devDependencies": {
    "@dnd-kit/core": "catalog:",
    "@dnd-kit/modifiers": "catalog:",
    "@dnd-kit/sortable": "catalog:",
    "@dnd-kit/utilities": "catalog:",
    "@support/jest-features-flow": "workspace:*",
    "@ledgerhq/lumen-ui-react": "catalog:",
    "@ledgerhq/lumen-ui-rnative": "catalog:",
    "@swc/core": "catalog:",
    "@swc/jest": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/react-native": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "eslint": "8.57.0",
    "eslint-plugin-better-tailwindcss": "catalog:",
    "jest": "catalog:",
    "jest-environment-jsdom": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:",
    "react-native-draggable-flatlist": "catalog:",
    "react-native-gesture-handler": "catalog:",
    "react-native-reanimated": "catalog:",
    "react-native-safe-area-context": "catalog:",
    "react-test-renderer": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@dnd-kit/core": "catalog:",
    "@dnd-kit/modifiers": "catalog:",
    "@dnd-kit/sortable": "catalog:",
    "@dnd-kit/utilities": "catalog:",
    "@ledgerhq/lumen-ui-react": "catalog:",
    "@ledgerhq/lumen-ui-rnative": "catalog:",
    "react": "catalog:",
    "react-native": "catalog:",
    "react-native-draggable-flatlist": "catalog:",
    "react-native-gesture-handler": "catalog:",
    "react-native-reanimated": "catalog:",
    "react-native-safe-area-context": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    },
    "@ledgerhq/lumen-ui-react": {
      "optional": true
    },
    "@ledgerhq/lumen-ui-rnative": {
      "optional": true
    },
    "@dnd-kit/core": {
      "optional": true
    },
    "@dnd-kit/modifiers": {
      "optional": true
    },
    "@dnd-kit/sortable": {
      "optional": true
    },
    "@dnd-kit/utilities": {
      "optional": true
    },
    "react-native-draggable-flatlist": {
      "optional": true
    },
    "react-native-gesture-handler": {
      "optional": true
    },
    "react-native-reanimated": {
      "optional": true
    },
    "react-native-safe-area-context": {
      "optional": true
    }
  }
}
