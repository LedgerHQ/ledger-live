{
  "name": "@features/flow-contacts-delete-contact",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Contact Delete flow for Desktop and Mobile",
  "main": "src/index.ts",
  "react-native": "src/index.native.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.native.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "format": "oxfmt src",
    "format:check": "oxfmt src --check",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.native.json",
    "test": "jest",
    "coverage": "jest --coverage",
    "unimported": "pnpm knip --directory ../../.. -c features/flow/flow-contacts-delete-contact/knip.web.config.mjs -W features/flow/flow-contacts-delete-contact --tsConfig tsconfig.web.json && pnpm knip --directory ../../.. -c features/flow/flow-contacts-delete-contact/knip.native.config.mjs -W features/flow/flow-contacts-delete-contact --tsConfig tsconfig.native.json"
  },
  "dependencies": {
    "@domain/entity-contact": "workspace:*",
    "@features/platform-contacts": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-native": ">=0.70.0",
    "react-redux": ">=9.0.0",
    "@ledgerhq/lumen-ui-react": "catalog:",
    "@ledgerhq/lumen-ui-rnative": "catalog:"
  },
  "peerDependenciesMeta": {
    "react-native": { "optional": true },
    "@ledgerhq/lumen-ui-react": { "optional": true },
    "@ledgerhq/lumen-ui-rnative": { "optional": true }
  },
  "devDependencies": {
    "@support/jest-features-flow": "workspace:*",
    "@reduxjs/toolkit": "catalog:",
    "@ledgerhq/lumen-ui-react": "catalog:",
    "@ledgerhq/lumen-ui-rnative": "catalog:",
    "@swc/core": "catalog:",
    "@swc/jest": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/react-native": "catalog:",
    "@types/jest": "catalog:",
    "@types/react": "catalog:",
    "jest": "catalog:",
    "jest-environment-jsdom": "catalog:",
    "oxfmt": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:",
    "react-redux": "catalog:",
    "react-test-renderer": "catalog:",
    "typescript": "catalog:"
  }
}
