{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "dom"],
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": { "*": ["./*"] },
    "noEmit": true,
    "types": ["jest", "node", "@testing-library/jest-dom"],
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "lib"],
}
