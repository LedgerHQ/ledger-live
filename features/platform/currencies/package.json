{
  "name": "@features/platform-currencies",
  "version": "0.8.1",
  "private": true,
  "description": "App-facing currency runtime: crypto-assets store builder, currency/token hooks, supported-set feature-flag gating",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./legacy": {
      "default": "./src/legacy/index.ts"
    }
  },
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "coverage": "jest --coverage",
    "lint": "lint-features-platform src",
    "lint:fix": "lint-features-platform src --fix",
    "format": "fmt-base src",
    "format:check": "fmt-base src --check"
  },
  "dependencies": {
    "@domain/api-currency-token": "workspace:^",
    "@domain/entity-currency-crypto": "workspace:^",
    "@domain/entity-currency-token": "workspace:^",
    "@features/platform-feature-flags": "workspace:^",
    "@reduxjs/toolkit": "catalog:",
    "@shared/api-services": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-redux": ">=9.0.0"
  },
  "devDependencies": {
    "@ledgerhq/test-quarantine": "workspace:*",
    "@shared/feature-flags": "workspace:^",
    "@support/fmt-base": "workspace:*",
    "@support/lint-features-platform": "workspace:*",
    "@support/ts-features-platform": "workspace:*",
    "@swc/core": "catalog:",
    "@swc/jest": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/jest": "catalog:",
    "@types/react": "catalog:",
    "jest": "catalog:",
    "jest-environment-jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-redux": "catalog:",
    "typescript": "catalog:"
  }
}
