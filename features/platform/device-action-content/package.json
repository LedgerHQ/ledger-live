{
  "name": "@features/platform-device-action-content",
  "version": "0.2.0-next.0",
  "private": true,
  "description": "Shared device-side action content (animation, copy, banner) for web and native",
  "main": "src/index.ts",
  "react-native": "src/index.native.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.native.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "format": "oxfmt src",
    "format:check": "oxfmt src --check",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.native.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "coverage": "jest --coverage",
    "unimported": "pnpm knip --directory ../../.. -c features/platform/device-action-content/knip.web.config.mjs -W features/platform/device-action-content --tsConfig tsconfig.web.json && pnpm knip --directory ../../.. -c features/platform/device-action-content/knip.native.config.mjs -W features/platform/device-action-content --tsConfig tsconfig.native.json"
  },
  "dependencies": {
    "@features/platform-style": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-native": ">=0.70.0",
    "@ledgerhq/lumen-ui-react": "catalog:",
    "@ledgerhq/lumen-ui-rnative": "catalog:",
    "lottie-react-native": "7.3.6",
    "react-lottie": "1.2.10",
    "prop-types": "15.8.1",
    "react-native-config": "catalog:",
    "styled-components": ">=6"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    },
    "@ledgerhq/lumen-ui-react": {
      "optional": true
    },
    "@ledgerhq/lumen-ui-rnative": {
      "optional": true
    },
    "lottie-react-native": {
      "optional": true
    },
    "react-lottie": {
      "optional": true
    },
    "prop-types": {
      "optional": true
    },
    "react-native-config": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ledgerhq/lumen-ui-react": "catalog:",
    "@ledgerhq/lumen-ui-rnative": "catalog:",
    "@support/jest-features-flow": "workspace:*",
    "@swc/core": "catalog:",
    "@swc/jest": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/react-native": "catalog:",
    "@types/jest": "catalog:",
    "@types/react": "catalog:",
    "@types/react-lottie": "1.2.10",
    "jest": "catalog:",
    "jest-environment-jsdom": "catalog:",
    "lottie-react-native": "7.3.6",
    "oxfmt": "catalog:",
    "prop-types": "15.8.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-lottie": "1.2.10",
    "react-native": "catalog:",
    "react-native-config": "catalog:",
    "react-test-renderer": "catalog:",
    "styled-components": "catalog:",
    "typescript": "catalog:"
  }
}
