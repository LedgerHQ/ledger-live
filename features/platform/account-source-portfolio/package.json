{
  "name": "@features/platform-account-source-portfolio",
  "version": "0.0.0",
  "private": true,
  "description": "The Portfolio service as an account data source: keeps the service's portfolio in step with the app's accounts and reads their balances in batches",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "format": "oxfmt src",
    "format:check": "oxfmt src --check",
    "lint": "oxlint ./src",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "coverage": "jest --coverage",
    "unimported": "pnpm knip --directory ../../.. -W features/platform/account-source-portfolio"
  },
  "dependencies": {
    "@domain/api-account-data": "workspace:*",
    "@domain/api-account-portfolio": "workspace:*",
    "@domain/entity-account-balance": "workspace:*",
    "@domain/entity-account-data": "workspace:*",
    "@domain/entity-account-descriptor": "workspace:*",
    "@domain/entity-client-identity": "workspace:*",
    "@reduxjs/toolkit": "catalog:"
  },
  "devDependencies": {
    "@ledgerhq/test-quarantine": "workspace:*",
    "@swc/core": "catalog:",
    "@swc/jest": "catalog:",
    "@types/jest": "catalog:",
    "jest": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  }
}
