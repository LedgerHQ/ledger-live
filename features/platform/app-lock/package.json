{
  "name": "@features/platform-app-lock",
  "version": "0.3.0",
  "private": true,
  "description": "App lock protection state: schemas, types and selectors shared by the flows that read it",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.native.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "format": "fmt-base src",
    "format:check": "fmt-base src --check",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "coverage": "jest --coverage",
    "unimported": "pnpm knip --directory ../../.. -W features/platform/app-lock",
    "lint": "lint-features-platform src",
    "lint:fix": "lint-features-platform src --fix"
  },
  "dependencies": {
    "@reduxjs/toolkit": "catalog:",
    "@shared/password-verifier": "workspace:*",
    "buffer": "catalog:",
    "react-native-biometrics": "catalog:",
    "react-native-fast-crypto": "catalog:",
    "react-native-keychain": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@ledgerhq/test-quarantine": "workspace:*",
    "@support/fmt-base": "workspace:*",
    "@support/lint-features-platform": "workspace:*",
    "@support/ts-features-platform": "workspace:*",
    "@swc/core": "catalog:",
    "@swc/jest": "catalog:",
    "@types/jest": "catalog:",
    "jest": "catalog:",
    "oxfmt": "catalog:",
    "typescript": "catalog:"
  }
}
