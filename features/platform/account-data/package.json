{
  "name": "@features/platform-account-data",
  "version": "0.1.0",
  "private": true,
  "description": "Generic React hook that triggers and refreshes account data reads",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
