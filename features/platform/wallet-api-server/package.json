{
  "name": "@features/platform-wallet-api-server",
  "version": "0.0.0",
  "private": true,
  "description": "The Wallet API server of a live app session, with the handlers that need no legacy Account",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./errors": "./src/errors.ts",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "format": "oxfmt src",
    "format:check": "oxfmt src --check",
    "lint": "oxlint ./src",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "coverage": "jest --coverage"
  },
  "dependencies": {
    "@domain/api-account-data": "workspace:*",
    "@domain/api-account-transaction": "workspace:*",
    "@domain/api-currency-token": "workspace:*",
    "@domain/entity-account-balance": "workspace:*",
    "@domain/entity-account-receive": "workspace:*",
    "@domain/entity-account-transaction": "workspace:*",
    "@domain/entity-currency-crypto": "workspace:*",
    "@domain/entity-currency-token": "workspace:*",
    "@features/platform-wallet-api-accounts": "workspace:*",
    "@ledgerhq/wallet-api-core": "catalog:",
    "@ledgerhq/wallet-api-server": "catalog:",
    "@reduxjs/toolkit": "catalog:",
    "@shared/feature-flags": "workspace:*",
    "rxjs": "catalog:",
    "semver": "catalog:"
  },
  "peerDependencies": {
    "react": ">=19.0.0"
  },
  "devDependencies": {
    "@domain/entity-account": "workspace:*",
    "@domain/entity-account-data": "workspace:*",
    "@domain/entity-account-descriptor": "workspace:*",
    "@domain/entity-account-operation": "workspace:*",
    "@ledgerhq/test-quarantine": "workspace:*",
    "@swc/core": "catalog:",
    "@swc/jest": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/jest": "catalog:",
    "@types/react": "catalog:",
    "@types/semver": "catalog:",
    "@typescript/native": "catalog:",
    "bignumber.js": "catalog:",
    "jest": "catalog:",
    "jest-environment-jsdom": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:"
  }
}
