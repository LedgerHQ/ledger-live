{
  "name": "@features/platform-contacts",
  "version": "0.1.0",
  "private": true,
  "description": "Contacts domain selectors for flow packages",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
