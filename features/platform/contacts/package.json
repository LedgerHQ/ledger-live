{
  "name": "@features/platform-contacts",
  "version": "0.5.0-next.0",
  "private": true,
  "description": "Contacts domain selectors for flow packages",
  "main": "src/index.ts",
  "react-native": "src/index.native.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.native.ts",
      "default": "./src/index.ts"
    },
    "./native": "./src/index.native.ts",
    "./web": "./src/web.ts",
    "./device": "./src/device/index.ts",
    "./device/intents": "./src/device/intents/index.ts",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "format": "oxfmt src",
    "format:check": "oxfmt src --check",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.native.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "coverage": "jest --coverage",
    "unimported": "pnpm knip --directory ../../.. -c features/platform/contacts/knip.web.config.mjs -W features/platform/contacts --tsConfig tsconfig.web.json && pnpm knip --directory ../../.. -c features/platform/contacts/knip.native.config.mjs -W features/platform/contacts --tsConfig tsconfig.native.json"
  },
  "dependencies": {
    "@domain/entity-contact": "workspace:*",
    "@domain/entity-currency-crypto": "workspace:*",
    "@domain/entity-currency-token": "workspace:*",
    "@features/platform-feature-flags": "workspace:^",
    "@shared/feature-flags": "workspace:^",
    "@features/platform-device-intent": "workspace:*",
    "@ledgerhq/device-contacts-kit": "catalog:",
    "@ledgerhq/device-signer-kit-ethereum": "catalog:",
    "rxjs": "catalog:",
    "semver": "catalog:"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-redux": ">=9.0.0",
    "react-native": ">=0.70.0",
    "@ledgerhq/device-management-kit": "catalog:",
    "@ledgerhq/lumen-ui-react": "catalog:",
    "@ledgerhq/lumen-ui-rnative": "catalog:"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    },
    "@ledgerhq/lumen-ui-rnative": {
      "optional": true
    },
    "@ledgerhq/lumen-ui-react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@support/jest-features-flow": "workspace:*",
    "@ledgerhq/device-management-kit": "catalog:",
    "@types/semver": "catalog:",
    "@ledgerhq/lumen-ui-react": "catalog:",
    "@ledgerhq/lumen-ui-rnative": "catalog:",
    "@reduxjs/toolkit": "catalog:",
    "@swc/core": "catalog:",
    "@swc/jest": "catalog:",
    "@types/jest": "catalog:",
    "@types/react": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/react-native": "catalog:",
    "jest": "catalog:",
    "jest-environment-jsdom": "catalog:",
    "oxfmt": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:",
    "react-redux": "catalog:",
    "react-test-renderer": "catalog:",
    "typescript": "catalog:"
  }
}
