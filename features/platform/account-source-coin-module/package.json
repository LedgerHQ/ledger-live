{
  "name": "@features/platform-account-source-coin-module",
  "version": "0.1.0",
  "private": true,
  "description": "The account data source that reads coin modules directly, without the generic coin framework layer",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "format": "oxfmt src",
    "format:check": "oxfmt src --check",
    "lint": "oxlint ./src",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "coverage": "jest --coverage",
    "unimported": "pnpm knip --directory ../../.. -W features/platform/account-source-coin-module"
  },
  "dependencies": {
    "@domain/api-account-data": "workspace:*",
    "@domain/entity-account-balance": "workspace:*",
    "@domain/entity-account-data": "workspace:*",
    "@domain/entity-account-descriptor": "workspace:*",
    "@domain/entity-account-operation": "workspace:*",
    "@ledgerhq/coin-module-framework": "catalog:"
  },
  "devDependencies": {
    "@ledgerhq/test-quarantine": "workspace:*",
    "@support/jest": "workspace:*",
    "@swc/core": "catalog:",
    "@swc/jest": "catalog:",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "jest": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  }
}
