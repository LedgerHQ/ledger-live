{
  "name": "@features/platform-feature-flags-firebase",
  "version": "0.0.0",
  "private": true,
  "description": "Firebase Remote Config mapping for feature flags: key naming, defaults formatting and payload parsing",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "format": "oxfmt src",
    "format:check": "oxfmt src --check",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "coverage": "jest --coverage",
    "unimported": "pnpm knip --directory ../../.. -W features/platform/feature-flags-firebase"
  },
  "dependencies": {
    "@shared/feature-flags": "workspace:^",
    "lodash": "catalog:"
  },
  "devDependencies": {
    "@ledgerhq/test-quarantine": "workspace:*",
    "@swc/core": "catalog:",
    "@swc/jest": "catalog:",
    "@types/jest": "catalog:",
    "@types/lodash": "catalog:",
    "jest": "catalog:",
    "oxfmt": "catalog:",
    "typescript": "catalog:"
  }
}
