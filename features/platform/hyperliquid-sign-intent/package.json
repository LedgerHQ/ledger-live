{
  "name": "@features/platform-hyperliquid-sign-intent",
  "version": "0.0.0",
  "private": true,
  "description": "Cross-platform Device Intent that signs Hyperliquid actions in the Hyperliquid device app",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "format": "oxfmt src",
    "format:check": "oxfmt --check src",
    "lint": "oxlint ./src",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "coverage": "jest --coverage"
  },
  "dependencies": {
    "@features/platform-device-intent": "workspace:^"
  },
  "peerDependencies": {
    "@ledgerhq/device-management-kit": "catalog:",
    "rxjs": "catalog:"
  },
  "devDependencies": {
    "@ledgerhq/device-management-kit": "catalog:",
    "@ledgerhq/test-quarantine": "workspace:*",
    "@support/jest": "workspace:*",
    "@swc/core": "catalog:",
    "@swc/jest": "catalog:",
    "@types/jest": "catalog:",
    "@typescript/native": "catalog:",
    "jest": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "rxjs": "catalog:",
    "typescript": "catalog:"
  }
}
