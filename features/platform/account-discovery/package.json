    "coverage": "jest --coverage"
  },
  "dependencies": {
    "@domain/entity-account-descriptor": "workspace:^",
    "@domain/entity-currency-crypto": "workspace:^",
    "rxjs": "catalog:"
  },
  "devDependencies": {
    "@jest/globals": "catalog:",
    "@ledgerhq/test-quarantine": "workspace:*",
    "@swc/core": "catalog:",
    "@swc/jest": "catalog:",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "jest": "catalog:",
    "typescript": "catalog:"
  }
