{
  "name": "@features/platform-account-discovery",
  "version": "0.1.0",
  "private": true,
  "description": "Account discovery as a stream of account descriptors, driven by an injected derivation and an existence predicate",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
