{
  "name": "@features/platform-app-update",
  "version": "0.0.0",
  "private": true,
  "description": "Integrity checks for desktop app updates",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "format": "oxfmt src",
    "format:check": "oxfmt --check src",
    "lint": "oxlint -c ../../../libs/oxc-live-libs/.oxlintrc.json ./src",
    "typecheck": "tsc --noEmit",
    "unimported": "pnpm knip --directory ../../.. -W features/platform/app-update",
    "test": "jest",
    "test:watch": "jest --watch",
    "coverage": "jest --coverage"
  },
  "dependencies": {
    "@noble/curves": "catalog:",
    "@trust/keyto": "1.0.1"
  },
  "devDependencies": {
    "@ledgerhq/test-quarantine": "workspace:*",
    "@support/jest-shared": "workspace:*",
    "@swc/core": "catalog:",
    "@swc/jest": "catalog:",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "@types/trust__keyto": "1.0.4",
    "jest": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  }
}
