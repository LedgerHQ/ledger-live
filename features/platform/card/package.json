{
  "name": "@features/platform-card",
  "version": "0.3.0",
  "private": true,
  "description": "Cross-flow Card runtime: in-memory Card session and the Bearer/refresh accessors the app injects into the shared cardApi service",
  "main": "src/index.ts",
  "react-native": "src/index.native.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.native.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "lint": "oxlint src",
    "lint:ci": "oxlint src --quiet",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.native.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "coverage": "jest --coverage",
    "unimported": "pnpm knip --directory ../../.. -c features/platform/card/knip.web.config.mjs -W features/platform/card --tsConfig tsconfig.web.json && pnpm knip --directory ../../.. -c features/platform/card/knip.native.config.mjs -W features/platform/card --tsConfig tsconfig.native.json"
  },
  "dependencies": {
    "@domain/api-card-management": "workspace:*",
    "react-native-keychain": "catalog:"
  },
  "devDependencies": {
    "@jest/globals": "catalog:",
    "@ledgerhq/test-quarantine": "workspace:*",
    "@support/jest-features-flow": "workspace:*",
    "jest-environment-jsdom": "catalog:",
    "@swc/core": "catalog:",
    "@swc/jest": "catalog:",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "jest": "catalog:",
    "typescript": "catalog:"
  }
}
