{
  "name": "@features/platform-account-discovery-intent",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-platform Device Intent that discovers the accounts of a currency on the device app the executor opened",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "format": "oxfmt src",
    "format:check": "oxfmt src --check",
    "lint": "oxlint ./src",
    "typecheck": "tsc --noEmit",
    "unimported": "pnpm knip --directory ../../.. -W features/platform/account-discovery-intent"
  },
  "dependencies": {
    "@features/platform-account-discovery": "workspace:*",
    "@features/platform-device-intent": "workspace:^"
  },
  "peerDependencies": {
    "@ledgerhq/device-management-kit": "catalog:",
    "rxjs": "catalog:"
  },
  "devDependencies": {
    "@domain/entity-account-descriptor": "workspace:*",
    "@domain/entity-derivation": "workspace:*",
    "@ledgerhq/device-management-kit": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "rxjs": "catalog:",
    "typescript": "catalog:"
  }
}
