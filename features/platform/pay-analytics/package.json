{
  "name": "@features/platform-pay-analytics",
  "version": "0.1.0",
  "private": true,
  "description": "Analytics tracking helpers for the Pay flow, shared across desktop and mobile",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./testing/module-mock": "./src/testing/moduleMock.tsx",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "format": "oxfmt src",
    "format:check": "oxfmt src --check",
    "lint": "oxlint src",
    "lint:ci": "oxlint src --quiet",
    "lint:fix": "oxfmt src && oxlint src --fix --quiet",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.native.json",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "coverage": "jest --coverage --passWithNoTests",
    "unimported": "pnpm knip --directory ../../.. -c features/platform/pay-analytics/knip.web.config.mjs -W features/platform/pay-analytics --tsConfig tsconfig.web.json && pnpm knip --directory ../../.. -c features/platform/pay-analytics/knip.native.config.mjs -W features/platform/pay-analytics --tsConfig tsconfig.native.json"
  },
  "dependencies": {
    "@shared/analytics": "workspace:*",
    "@shared/analytics-react": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=19.0.0"
  },
  "devDependencies": {
    "@jest/globals": "catalog:",
    "@ledgerhq/test-quarantine": "workspace:*",
    "@swc/core": "catalog:",
    "@swc/jest": "catalog:",
    "@types/jest": "catalog:",
    "@types/react": "catalog:",
    "jest": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:"
  }
}
