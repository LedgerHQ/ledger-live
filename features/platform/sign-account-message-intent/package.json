{
  "name": "@features/platform-sign-account-message-intent",
  "version": "0.0.0",
  "private": true,
  "description": "Cross-platform Device Intent that signs a message with an account on the device, whatever source serves it",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "format": "oxfmt src",
    "format:check": "oxfmt src --check",
    "lint": "oxlint src",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "coverage": "jest --coverage"
  },
  "dependencies": {
    "@domain/api-account-transaction": "workspace:*",
    "@features/platform-device-intent": "workspace:^"
  },
  "peerDependencies": {
    "@ledgerhq/device-management-kit": "catalog:",
    "rxjs": "catalog:"
  },
  "devDependencies": {
    "@ledgerhq/device-management-kit": "catalog:",
    "@swc/core": "catalog:",
    "@swc/jest": "catalog:",
    "@types/jest": "catalog:",
    "@typescript/native": "catalog:",
    "jest": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "rxjs": "catalog:",
    "typescript": "catalog:"
  }
}
