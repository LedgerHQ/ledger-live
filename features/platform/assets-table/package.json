{
  "name": "@features/platform-assets-table",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop assets table (name, price, balance, value, trend) shared by Portfolio, Crypto addresses and Account Detail",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./test-id": "./src/test-id.ts",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "format": "oxfmt src",
    "format:check": "oxfmt src --check",
    "lint": "oxlint src",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "coverage": "jest --coverage",
    "unimported": "pnpm knip --directory ../../.. -W features/platform/assets-table"
  },
  "dependencies": {
    "@domain/entity-currency": "workspace:*",
    "@domain/entity-currency-unit": "workspace:*",
    "@features/platform-market-countervalues": "workspace:*",
    "@ledgerhq/crypto-icons": "catalog:",
    "@ledgerhq/lumen-design-core": "catalog:",
    "@shared/i18n": "workspace:*",
    "bignumber.js": "catalog:"
  },
  "peerDependencies": {
    "@ledgerhq/lumen-ui-react": "catalog:",
    "@tanstack/react-table": "catalog:",
    "react": ">=19.0.0"
  },
  "devDependencies": {
    "@domain/entity-currency-crypto": "workspace:*",
    "@domain/entity-currency-fiat": "workspace:*",
    "@ledgerhq/lumen-ui-react": "catalog:",
    "@ledgerhq/test-quarantine": "workspace:*",
    "@support/jest": "workspace:*",
    "@swc/core": "catalog:",
    "@swc/jest": "catalog:",
    "@tanstack/react-table": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/jest": "catalog:",
    "@types/react": "catalog:",
    "jest": "catalog:",
    "jest-environment-jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:"
  }
}
