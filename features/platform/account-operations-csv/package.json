{
  "name": "@features/platform-account-operations-csv",
  "version": "0.1.0",
  "private": true,
  "description": "Builds the operations history CSV of accounts from the account data",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "oxlint src",
    "format": "oxfmt src",
    "format:check": "oxfmt src --check",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "coverage": "jest --coverage"
  },
  "dependencies": {
    "@domain/api-account-data": "workspace:*",
    "@domain/entity-account": "workspace:*",
    "@domain/entity-account-data": "workspace:*",
    "@domain/entity-account-descriptor": "workspace:*",
    "@domain/entity-account-operation": "workspace:*",
    "@domain/entity-currency": "workspace:*",
    "@domain/entity-currency-fiat": "workspace:*",
    "@domain/entity-currency-unit": "workspace:*",
    "@domain/entity-market-countervalues": "workspace:*",
    "@reduxjs/toolkit": "catalog:",
    "bignumber.js": "catalog:"
  },
  "devDependencies": {
    "@domain/entity-currency-crypto": "workspace:*",
    "@domain/entity-currency-token": "workspace:*",
    "@ledgerhq/test-quarantine": "workspace:*",
    "@support/jest": "workspace:*",
    "@swc/core": "catalog:",
    "@swc/jest": "catalog:",
    "@types/jest": "catalog:",
    "@typescript/native": "catalog:",
    "jest": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  },
  "sideEffects": false
}
