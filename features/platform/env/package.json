{
  "name": "@features/platform-env",
  "version": "0.3.1",
  "private": true,
  "description": "React hook for typed env var subscriptions",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "unimported": "pnpm knip --directory ../../.. -W features/platform/env",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix",
    "format": "fmt-base src",
    "format:check": "fmt-base src --check"
  },
  "dependencies": {
    "@shared/env": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=19.0.0"
  },
  "devDependencies": {
    "@support/fmt-base": "workspace:*",
    "@support/ts-features-platform": "workspace:*",
    "@types/react": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:"
  }
}
