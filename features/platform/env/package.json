{
  "name": "@features/platform-env",
  "version": "0.4.3",
  "private": true,
  "description": "React hook for typed env var subscriptions",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "lint": "oxlint src",
    "format": "oxfmt src",
    "format:check": "oxfmt src --check",
    "typecheck": "tsc --noEmit",
    "unimported": "pnpm knip --directory ../../.. -W features/platform/env"
  },
  "dependencies": {
    "@shared/env": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=19.0.0"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@typescript/native": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:"
  }
}
