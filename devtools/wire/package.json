    "coverage": "jest --config jest.config.js --coverage"
  },
  "dependencies": {
    "@devtools/protocols": "workspace:*",
    "@devtools/transport": "workspace:*"
  },
  "devDependencies": {
    "@swc/core": "catalog:",
    "@swc/jest": "catalog:",
    "@types/jest": "catalog:",
    "jest": "catalog:",
    "typescript": "catalog:"
  }
}
