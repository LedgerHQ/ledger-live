{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "moduleSuffixes": [".web", ""],
    // jest-dom is loaded by the shared web preset's setupFilesAfterEnv; naming it here is what
    // registers its matcher types (toBeVisible, toBeInTheDocument, …).
    "types": ["jest", "@testing-library/jest-dom"]
  },
  "include": ["src/**/*", "jest/**/*", "**/*.d.ts"],
  "exclude": ["node_modules", "jest/**/*.native.*", "src/**/*.native.*"]
}
