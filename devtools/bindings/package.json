{
  "name": "@devtools/bindings",
  "version": "0.12.0",
  "private": true,
  "description": "App-specific builders that adapt Ledger Live state into @devtools tool props (one builder per tool)",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "format": "oxfmt src",
    "format:check": "oxfmt src --check",
    "test": "jest",
    "test:watch": "jest --watch",
    "coverage": "jest --coverage",
    "lint": "oxlint src",
    "unimported": "pnpm knip --directory ../.. -c devtools/bindings/knip.web.config.mjs -W devtools/bindings --tsConfig tsconfig.json && pnpm knip --directory ../.. -c devtools/bindings/knip.native.config.mjs -W devtools/bindings --tsConfig tsconfig.json"
  },
  "dependencies": {
    "@devtools/env": "workspace:*",
    "@devtools/registry": "workspace:*",
    "@domain/api-account-data": "workspace:*",
    "@domain/api-account-portfolio": "workspace:*",
    "@domain/api-card-management": "workspace:*",
    "@domain/api-currency-token": "workspace:*",
    "@domain/entity-account": "workspace:*",
    "@domain/entity-account-balance": "workspace:*",
    "@domain/entity-account-data": "workspace:*",
    "@domain/entity-account-descriptor": "workspace:*",
    "@domain/entity-account-name": "workspace:*",
    "@domain/entity-account-operation": "workspace:*",
    "@domain/entity-card-asset-mapping": "workspace:*",
    "@domain/entity-client-identity": "workspace:*",
    "@domain/entity-currency": "workspace:^",
    "@domain/entity-currency-crypto": "workspace:*",
    "@domain/entity-currency-unit": "workspace:*",
    "@features/flow-pay-card-auth": "workspace:*",
    "@features/flow-pay-card-wallets": "workspace:*",
    "@features/flow-pay-card-widget": "workspace:*",
    "@features/flow-pay-feature-tour": "workspace:*",
    "@features/flow-pay-request": "workspace:*",
    "@features/platform-account-source-portfolio": "workspace:*",
    "@features/platform-card": "workspace:*",
    "@features/platform-device-onboarding": "workspace:*",
    "@features/platform-feature-flags": "workspace:*",
    "@ledgerhq/coin-module-framework": "catalog:",
    "@reduxjs/toolkit": "catalog:",
    "@shared/api-services": "workspace:*",
    "@shared/app-config": "workspace:*",
    "@shared/env": "workspace:*",
    "@shared/feature-flags": "workspace:*",
    "bignumber.js": "catalog:",
    "xstate": "catalog:"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-redux": ">=9.0.0"
  },
  "devDependencies": {
    "@ledgerhq/test-quarantine": "workspace:*",
    "@shared/api-services": "workspace:*",
    "@swc/core": "catalog:",
    "@swc/jest": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/jest": "catalog:",
    "@types/react": "catalog:",
    "jest": "catalog:",
    "jest-environment-jsdom": "catalog:",
    "jest-sonar": "0.2.16",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-redux": "catalog:",
    "typescript": "catalog:"
  }
}
