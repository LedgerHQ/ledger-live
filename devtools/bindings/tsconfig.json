{
  "extends": "@support/ts-devtools",
  "compilerOptions": {
    "module": "ES2022",
    "moduleSuffixes": [
      ".web",
      ""
    ],
    "paths": {
      "*": [
        "./*"
      ]
    },
    "types": [
      "jest",
      "@testing-library/jest-dom"
    ]
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "lib"
  ]
}
