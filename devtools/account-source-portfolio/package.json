{
  "name": "@devtools/account-source-portfolio",
  "version": "0.1.0",
  "private": true,
  "description": "DevTools page for the Portfolio account data source: how the service portfolio matches the local accounts, and what the source did",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
