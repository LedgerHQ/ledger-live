{
  "name": "@devtools/env",
  "version": "0.1.0",
  "private": true,
  "description": "DevTools panel to inspect, override, and reset individual env vars at runtime",
  "main": "src/index.ts",
  "react-native": "src/index.native.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "format": "oxfmt src",
    "format:check": "oxfmt src --check",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.native.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "coverage": "jest --coverage",
    "lint": "oxlint src"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "@ledgerhq/lumen-ui-rnative": "catalog:"
  },
  "devDependencies": {
    "@ledgerhq/lumen-ui-rnative": "catalog:",
    "@support/jest-devtools": "workspace:*",
    "@swc/core": "catalog:",
    "@swc/jest": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/jest": "catalog:",
    "@types/react": "catalog:",
    "jest": "catalog:",
    "jest-environment-jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:",
    "typescript": "catalog:"
  }
}
