{
  "extends": [
    "./tsconfig.json",
    "@support/ts-preset/web"
  ],
  "compilerOptions": {
    "types": [
      "jest",
      "@testing-library/jest-dom"
    ]
  },
  "include": [
    "src/**/*",
    "jest/**/*",
    "**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "jest/**/*.native.*",
    "src/**/*.native.*"
  ]
}
