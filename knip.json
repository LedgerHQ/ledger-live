{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "rules": {
    "binaries": "off",
    "classMembers": "off",
    "dependencies": "error",
    "devDependencies": "off",
    "optionalPeerDependencies": "off",
    "duplicates": "error",
    "enumMembers": "warn",
    "exports": "warn",
    "files": "error",
    "nsExports": "off",
    "nsTypes": "off",
    "types": "warn",
    "unlisted": "off",
    "unresolved": "off"
  },
  "ignoreExportsUsedInFile": true,
  "project": [
    "src/**"
  ],
  "ignore": [
    "**/__integrations__/*",
    "**/*.test.*",
    "**/*.spec.*",
    "**/tests/**",
    "**/__test__/**",
    "**/__tests__/**",
    "**/__mocks__/**",
    "**/e2e/**",
    "**/*.config.*",
    "**/scripts/**",
    "**/tools/**",
    "**/.eslintrc.guardrails.js",
    "**/.eslintrc.i18n.js"
  ],
