    "!libs/coin-tester-modules/coin-tester-casper",
    "!libs/coin-tester-modules/coin-tester-cosmos",
    "!libs/coin-tester-modules/coin-tester-kaspa",
    "!libs/coin-tester-modules/coin-tester-multiversx",
    "!libs/coin-tester-modules/coin-tester-near",
    "!libs/coin-tester-modules/coin-tester-stacks",
    "!libs/coin-tester-modules/coin-tester-stellar",
    "!libs/coin-tester-modules/coin-tester-ton",
    "!libs/coin-tester-modules/coin-tester-vechain",
    "!libs/coin-tester-modules/coin-tester-zcash",
    "!libs/live-dmk-mobile",
    "!libs/live-engagement",
    "!libs/live-send",
    "!libs/live-signer-icp",
    "!libs/live-signer-polkadot",
    "!libs/live-signer-tron",
