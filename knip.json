{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "rules": {
    "binaries": "off",
    "catalog": "off",
    "catalogReferences": "off",
    "dependencies": "error",
    "devDependencies": "off",
    "duplicates": "error",
    "enumMembers": "warn",
    "exports": "warn",
    "files": "error",
    "nsExports": "off",
    "nsTypes": "off",
    "optionalPeerDependencies": "off",
    "types": "warn",
    "unlisted": "off",
    "unresolved": "off"
  },
  "ignoreExportsUsedInFile": true,
  "github-actions": false,
  "project": ["src/**"],
  "ignore": [
    "**/__integrations__/*",
    "**/*.test.*",
    "**/*.spec.*",
    "**/tests/**",
    "**/__test__/**",
    "**/__tests__/**",
    "**/__mocks__/**",
    "**/e2e/**",
    "**/*.config.*",
    "**/scripts/**",
    "**/tools/**",
    "**/*.mock.*",
    "**/*.d.ts",
    "**/.eslintrc.guardrails.js",
    "**/.eslintrc.i18n.js",
    "**/.eslintrc.tailwind.js"
  ],
  "workspaces": {
    "./apps/ledger-live-desktop": {
      "entry": [
        "src/index.ts",
        "src/renderer/index.ts",
        "src/renderer/bootstrap/process.ts",
        "src/preloader/index.ts",
        "src/renderer/webworkers/workers/*.ts",
        "src/webviewPreloader/dappPreloader.ts",
        "src/webviewPreloader/index.ts"
      ],
      "ignore": [
        "src/renderer/mockServiceWorker.js",
        "src/errors.ts"
      ],
      "ignoreDependencies": [
        "prop-types",
        "allure-commandline",
        "ws",
        "@electron/fuses",
        "embla-carousel-autoplay",
        "embla-carousel-react",
        "@ledgerhq/zcash-utils"
      ]
    },
    "./apps/ledger-live-mobile": {
      "entry": ["index.js", "src/families/**"],
      "ignore": [
        "src/**/*.android.*",
        "src/**/*.ios.*",
        "babel-plugin-inject-collapsable.js",
        "src/devTools/perfUtils.ts"
      ],
      "ignoreDependencies": [
        "@react-native/assets-registry",
        "@react-native/community-cli-plugin",
        "@react-native/gradle-plugin",
        "buffer",
        "expo-crypto",
        "expo-document-picker",
        "expo-file-system",
        "expo-image-loader",
        "expo-modules-autolinking",
        "expo-modules-core",
        "prop-types",
        "react-is",
        "react-native-fast-pbkdf2",
        "react-native-navigation-bar-color",
        "react-native-randombytes",
        "react-native-udp",
        "stylis"
      ]
    },
    "./libs/live-wallet": {
      "entry": ["src/walletSyncComposition.ts", "src/accounts/index.ts"]
    },
    "./libs/coin-tester-modules/coin-tester-kaspa": {
      "ignore": ["miner/miner.js"]
    }
  }
}
