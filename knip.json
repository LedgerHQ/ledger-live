{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "rules": {
    "binaries": "off",
    "classMembers": "off",
    "dependencies": "error",
    "devDependencies": "off",
    "optionalPeerDependencies": "off",
    "duplicates": "error",
    "enumMembers": "warn",
    "exports": "warn",
    "files": "error",
    "nsExports": "off",
    "nsTypes": "off",
    "types": "warn",
    "unlisted": "off",
    "unresolved": "off"
  },
  "ignoreExportsUsedInFile": true,
  "project": ["src/**"],
  "ignore": [
    "**/__integrations__/*",
    "**/*.test.*",
    "**/*.spec.*",
    "**/tests/**",
    "**/__test__/**",
    "**/__tests__/**",
    "**/__mocks__/**",
    "**/e2e/**",
    "**/*.config.*",
    "**/scripts/**",
    "**/tools/**",
    "**/*.mock.*",
    "**/.eslintrc.guardrails.js",
    "**/.eslintrc.i18n.js",
    "**/.eslintrc.tailwind.js"
  ],
  "workspaces": {
    "./apps/ledger-live-desktop": {
      "entry": [
        "src/index.ts",
        "src/renderer/index.ts",
        "src/preloader/index.ts",
        "src/renderer/webworkers/workers/*.ts",
        "src/webviewPreloader/dappPreloader.ts",
        "src/webviewPreloader/index.ts"
      ],
      "ignore": [
        ".storybook/stub.ts",
        ".storybook/electronStub.js",
        ".storybook/fsStub.js",
        ".storybook/settingsMock.ts",
        "src/renderer/mockServiceWorker.js",
        "src/errors.ts"
      ],
      "ignoreDependencies": [
        "prop-types",
        "allure-commandline",
        "ws",
        "@electron/fuses",
        "embla-carousel-autoplay",
        "embla-carousel-react",
        "events",
        "@ledgerhq/zcash-utils"
      ]
    },
    "./apps/ledger-live-mobile": {
      "entry": ["index.js", "src/families/**"],
      "ignore": [
        "src/**/*.android.*",
        "src/**/*.ios.*",
        "babel-plugin-inject-collapsable.js",
        "src/devTools/perfUtils.ts"
      ],
      "ignoreDependencies": [
        "@react-native/assets-registry",
        "@react-native/community-cli-plugin",
        "@react-native/gradle-plugin",
        "buffer",
        "expo-crypto",
        "expo-file-system",
        "expo-image-loader",
        "expo-modules-autolinking",
        "expo-modules-core",
        "prop-types",
        "react-is",
        "react-native-fast-pbkdf2",
        "react-native-navigation-bar-color",
        "react-native-randombytes",
        "react-native-udp",
        "stylis"
      ]
    },
    "./libs/live-countervalues": {
      "ignoreDependencies": ["@ledgerhq/live-network"]
    },
    "./libs/live-wallet": {
      "entry": ["src/walletsync/index.ts", "src/liveqr/cross.ts", "src/liveqr/importAccounts.ts"]
    },
    "./libs/hw-ledger-key-ring-protocol": {
      "ignoreDependencies": ["@ledgerhq/live-env"]
    },
    "./libs/ui/packages/native": {
      "entry": [
        "src/assets/icons.ts",
        "src/styles/InvertTheme.tsx",
        "src/icons/Close.tsx",
        "storybook/stories/index.ts",
        "index.js"
      ],
      "ignoreDependencies": ["stylis"],
      "ignore": [".storybook*/*", "storybook/constants/*"]
    },
    "./libs/ui/packages/icons": {
      "ignore": ["index.js"]
    },
    "./libs/coin-tester-modules/coin-tester-cosmos": {
      "ignoreDependencies": ["expect"]
    },
    "./features/flow/market-banner": {
      "entry": ["src/components/MarketBanner/index.native.ts"]
    },
    "./features/flow/contacts": {
      "entry": ["src/jest.native.ts"]
    }
  }
}
