{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "rules": {
    "binaries": "off",
    "catalog": "off",
    "catalogReferences": "off",
    "dependencies": "error",
    "devDependencies": "off",
    "duplicates": "error",
    "enumMembers": "warn",
    "exports": "warn",
    "files": "error",
    "nsExports": "off",
    "nsTypes": "off",
    "optionalPeerDependencies": "off",
    "types": "warn",
    "unlisted": "off",
    "unresolved": "off"
  },
  "ignoreExportsUsedInFile": true,
  "github-actions": false,
  "project": ["src/**"],
  "ignore": [
    "**/__integrations__/*",
    "**/*.test.*",
    "**/*.spec.*",
    "**/tests/**",
    "**/__test__/**",
    "**/__tests__/**",
    "**/__mocks__/**",
    "**/e2e/**",
    "**/*.config.*",
    "**/scripts/**",
    "**/tools/**",
    "**/*.mock.*",
    "**/*.d.ts",
    "**/.eslintrc.guardrails.js",
    "**/.eslintrc.i18n.js"
  ],
  "ignoreWorkspaces": [
    "**",
    "!apps/ledger-live-desktop",
    "!apps/ledger-live-mobile",
    "!devtools/protocols",
    "!devtools/registry",
    "!devtools/relay",
    "!devtools/transport",
    "!devtools/wire",
    "!domain/api/account-data",
    "!domain/api/account-portfolio",
    "!domain/api/aggregated-assets",
    "!domain/api/card-management",
    "!domain/api/currency-fiat",
    "!domain/api/currency-token",
    "!domain/api/market-countervalues",
    "!domain/api/market-index-altcoin-season",
    "!domain/api/market-index-fear-and-greed",
    "!domain/api/ofac",
    "!domain/api/push-devices",
    "!domain/api/swap-quotes",
    "!domain/entity/account",
    "!domain/entity/account-alias",
    "!domain/entity/account-balance",
    "!domain/entity/account-balance-history",
    "!domain/entity/account-data",
    "!domain/entity/account-descriptor",
    "!domain/entity/account-name",
    "!domain/entity/account-operation",
    "!domain/entity/aggregated-asset",
    "!domain/entity/analytics-consent",
    "!domain/entity/card-asset-mapping",
    "!domain/entity/client-identity",
    "!domain/entity/contact",
    "!domain/entity/currency",
    "!domain/entity/currency-crypto",
    "!domain/entity/currency-fiat",
    "!domain/entity/currency-token",
    "!domain/entity/currency-unit",
    "!domain/entity/interest-rate",
    "!domain/entity/market-countervalues",
    "!domain/entity/market-index-altcoin-season",
    "!domain/entity/market-index-fear-and-greed",
    "!domain/entity/predictions",
    "!domain/entity/recent-addresses",
    "!domain/entity/starred-account",
    "!domain/entity/wallet-sync",
    "!e2e/tooling/baanx-test-client",
    "!features/flow/analytics-consent",
    "!features/flow/app-availability",
    "!features/flow/app-longer-password",
    "!features/flow/app-password-removal",
    "!features/flow/app-password-setup",
    "!features/flow/app-protection-prompt",
    "!features/flow/app-unlock",
    "!features/flow/contacts",
    "!features/flow/large-screen-upsell",
    "!features/flow/market-banner",
    "!features/flow/pay-bank-transfer",
    "!features/flow/pay-card-wallets",
    "!features/flow/pay-deposit",
    "!features/flow/pay-feature-tour",
    "!features/flow/pay-request",
    "!features/platform/account-analytics",
    "!features/platform/account-data",
    "!features/platform/account-source-coin-module",
    "!features/platform/aggregated-assets",
    "!features/platform/app-update",
    "!features/platform/assets-table",
    "!features/platform/card",
    "!features/platform/coin-observability",
    "!features/platform/content-ab-tests",
    "!features/platform/device-intent",
    "!features/platform/device-onboarding",
    "!features/platform/env",
    "!features/platform/feature-flags",
