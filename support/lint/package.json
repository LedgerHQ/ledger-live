{
  "name": "@support/lint",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "The repository's oxlint presets, one per layer that differs, and its custom rules",
  "exports": {
    "./base": "./base.mts",
    "./devtools": "./devtools.mts",
    "./features-flow": "./features-flow.mts",
    "./features-platform": "./features-platform.mts",
    "./libs": "./libs.mts",
    "./libs-coin": "./libs-coin.mts",
    "./libs-coin-tester": "./libs-coin-tester.mts",
    "./shared": "./shared.mts",
    "./support": "./support.mts",
    "./tools": "./tools.mts",
    "./restricted-imports": "./restricted-imports.mts",
    "./plugins": "./plugins.mts",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "format": "oxfmt *.mts *.js src",
    "format:check": "oxfmt *.mts *.js src --check",
    "generate:restricted-imports": "node src/restricted-imports-fragments.js",
    "lint": "oxlint *.mts *.js src",
    "lint:sensitive": "cd ../.. && ESLINT_USE_FLAT_CONFIG=true NODE_OPTIONS=--max-old-space-size=16384 support/lint/node_modules/.bin/eslint -c support/lint/eslint.sensitive.config.js --no-inline-config domain features shared",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@ledgerhq/lumen-lint-plugin": "catalog:",
    "@types/node": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "@typescript/native": "catalog:",
    "eslint": "8.57.0",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:"
  }
}
