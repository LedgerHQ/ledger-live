{
  "name": "@support/lint",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The repository's oxlint presets, one per layer that differs, and its custom rules",
  "exports": {
    "./base": "./base.mts",
    "./devtools": "./devtools.mts",
    "./features-flow": "./features-flow.mts",
    "./features-platform": "./features-platform.mts",
    "./libs": "./libs.mts",
    "./libs-coin": "./libs-coin.mts",
    "./libs-coin-tester": "./libs-coin-tester.mts",
    "./shared": "./shared.mts",
    "./support": "./support.mts",
    "./tools": "./tools.mts",
    "./restricted-imports": "./restricted-imports.mts",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "format": "oxfmt *.mts src",
    "format:check": "oxfmt *.mts src --check",
    "generate:restricted-imports": "node src/restricted-imports-fragments.js",
    "lint": "oxlint *.mts src",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@ledgerhq/lumen-lint-plugin": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  }
}
