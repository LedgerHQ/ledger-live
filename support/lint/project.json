{
  "name": "@support/lint",
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/restricted-imports.mts",
        "{projectRoot}/restricted-imports/**/*"
      ],
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "node --test support/lint/src/suffix-imports.test.js support/lint/src/restricted-imports-fragments.test.js"
      }
    }
  }
}
