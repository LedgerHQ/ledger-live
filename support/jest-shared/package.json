{
  "name": "@support/jest-shared",
  "version": "0.2.0-next.0",
  "private": true,
  "description": "Shared jest config + generic Lumen stubs for shared/* packages",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./mocks/*": "./mocks/*.js",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "index.js",
    "mocks",
    "setup"
  ],
  "scripts": {
    "format": "oxfmt index.js mocks setup",
    "format:check": "oxfmt index.js mocks setup --check",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "react": "catalog:"
  }
}
