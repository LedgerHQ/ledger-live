{
  "name": "@support/jest",
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/core/**/*",
        "{projectRoot}/devtools/**/*",
        "{projectRoot}/shared/**/*",
        "{projectRoot}/features-flow/**/*",
        "{projectRoot}/internals/**/*",
        "{projectRoot}/libs-coin/**/*"
      ],
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "node --test support/jest/core/index.test.ts support/jest/core/preset-overrides.test.ts support/jest/devtools/index.test.ts support/jest/features-flow/resolver.native.test.ts support/jest/features-flow/setup/web.test.ts support/jest/libs-coin/index.test.ts"
      }
    }
  }
}
