{
  "extends": "@support/ts-base",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "lib": [
      "ES2022"
    ]
  },
  "include": [
    "${configDir}/src/**/*"
  ],
  "exclude": [
    "node_modules",
    "${configDir}/lib"
  ]
}
