{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "rules": {
    "binaries": "off",
    "catalog": "off",
    "catalogReferences": "off",
    "dependencies": "error",
    "devDependencies": "off",
    "duplicates": "error",
    "enumMembers": "warn",
    "exports": "warn",
    "files": "error",
    "nsExports": "off",
    "nsTypes": "off",
    "optionalPeerDependencies": "off",
    "types": "warn",
    "unlisted": "off",
    "unresolved": "off"
  },
  "ignoreExportsUsedInFile": true,
  "github-actions": false,
  "project": ["src/**"],
  "ignore": [
    "**/__integrations__/*",
    "**/*.test.*",
    "**/*.spec.*",
    "**/tests/**",
    "**/__test__/**",
    "**/__tests__/**",
    "**/__mocks__/**",
    "**/e2e/**",
    "**/*.config.*",
    "**/scripts/**",
    "**/tools/**",
    "**/*.mock.*",
    "**/*.d.ts",
    "**/.eslintrc.guardrails.js",
    "**/.eslintrc.i18n.js",
    ".agents/**"
  ],
  "ignoreWorkspaces": [
    "apps/cli",
    "apps/wallet-cli",
    "apps/wallet-cli/**",
    "apps/web-tools",
    "e2e/desktop",
    "e2e/mobile",
    "libs/asset-aggregation",
    "libs/asset-detail",
    "libs/coin-modules-monitoring",
    "libs/coin-modules/coin-aleo",
    "libs/coin-modules/coin-algorand",
    "libs/coin-modules/coin-aptos",
    "libs/coin-modules/coin-bitcoin",
    "libs/coin-modules/coin-canton",
    "libs/coin-modules/coin-cardano",
    "libs/coin-modules/coin-casper",
    "libs/coin-modules/coin-celo",
    "libs/coin-modules/coin-concordium",
    "libs/coin-modules/coin-cosmos",
    "libs/coin-modules/coin-filecoin",
    "libs/coin-modules/coin-hedera",
    "libs/coin-modules/coin-icon",
    "libs/coin-modules/coin-internet_computer",
    "libs/coin-modules/coin-kaspa",
    "libs/coin-modules/coin-mina",
    "libs/coin-modules/coin-module-boilerplate",
    "libs/coin-modules/coin-multiversx",
    "libs/coin-modules/coin-near",
    "libs/coin-modules/coin-polkadot",
    "libs/coin-modules/coin-solana",
    "libs/coin-modules/coin-stacks",
    "libs/coin-modules/coin-sui",
    "libs/coin-modules/coin-ton",
    "libs/coin-modules/coin-tron",
    "libs/coin-modules/coin-vechain",
    "libs/coin-tester",
    "libs/coin-tester-modules/coin-tester-bitcoin",
    "libs/coin-tester-modules/coin-tester-evm",
    "libs/coin-tester-modules/coin-tester-polkadot",
    "libs/coin-tester-modules/coin-tester-solana",
    "libs/coin-tester-modules/coin-tester-tezos",
    "libs/coin-tester-modules/coin-tester-tron",
    "libs/coin-tester-modules/coin-tester-xrp",
    "libs/concordium-core",
    "libs/deeplink-module",
    "libs/device-core",
    "libs/device-react",
    "libs/disable-network-setup",
    "libs/ethereum-provider",
    "libs/exchange-module",
    "libs/feature-flag-module",
    "libs/hw-transport-http",
    "libs/ledger-live-common",
    "libs/ledger-services/**",
    "libs/ledger-wallet-framework",
    "libs/ledgerjs",
    "libs/ledgerjs/**",
    "libs/live-dmk-desktop",
    "libs/live-dmk-shared",
    "libs/live-dmk-speculos",
    "libs/live-e2e-shared",
    "libs/live-signer-aleo",
    "libs/live-signer-canton",
    "libs/live-signer-celo",
    "libs/live-signer-concordium",
    "libs/live-signer-cosmos",
    "libs/live-signer-evm",
    "libs/live-signer-hyperliquid",
    "libs/live-signer-solana",
    "libs/live-signer-zcash",
    "libs/speculos-transport",
    "libs/test-utils",
    "libs/types-devices",
    "libs/types-live",
    "libs/ui",
    "libs/ui/packages/shared",
    "libs/wallet-pnl",
    "tests/**",
    "tools/actions",
    "tools/actions/**",
    "tools/create-release-hash"
  ],
  "workspaces": {
    "./apps/ledger-live-desktop": {
      "entry": [
        "src/index.ts",
        "src/renderer/index.ts",
        "src/renderer/bootstrap/process.ts",
        "src/preloader/index.ts",
        "src/renderer/webworkers/workers/*.ts",
        "src/webviewPreloader/dappPreloader.ts",
        "src/webviewPreloader/index.ts"
      ],
      "ignore": [
        "src/renderer/mockServiceWorker.js",
        "src/errors.ts"
      ],
      "ignoreDependencies": [
        "prop-types",
        "ws",
        "@electron/fuses",
        "embla-carousel-autoplay",
        "embla-carousel-react",
        "events",
        "@ledgerhq/zcash-utils"
      ]
    },
    "./apps/ledger-live-mobile": {
      "entry": ["index.js", "src/families/**"],
      "ignore": [
        "src/**/*.android.*",
        "src/**/*.ios.*",
        "babel-plugin-inject-collapsable.js",
        "src/devTools/perfUtils.ts"
      ],
      "ignoreDependencies": [
        "@react-native/assets-registry",
        "@react-native/community-cli-plugin",
        "@react-native/gradle-plugin",
        "@shared/ui-glow",
        "buffer",
        "expo-crypto",
        "expo-document-picker",
        "expo-file-system",
        "expo-image-loader",
        "expo-modules-autolinking",
        "expo-modules-core",
        "prop-types",
        "react-is",
        "react-native-fast-pbkdf2",
        "stylis"
      ]
    },
    "./libs/live-wallet": {
      "entry": ["src/walletSyncComposition.ts", "src/accounts/index.ts"]
    },
    "./libs/coin-tester-modules/coin-tester-kaspa": {
      "ignore": ["miner/miner.js"]
    },
    "./support/jest": {
      "entry": ["devtools/mocks/*", "devtools/setup/*"]
    },
    "./features/platform/app-lock": {
      "ignoreDependencies": ["buffer"]
    }
  }
}
