{
  "name": "@domain/api-account-transaction",
  "version": "0.0.0",
  "private": true,
  "description": "Sending from an account: what a source implements to prepare, sign and broadcast, routed over the account data sources",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "format": "oxfmt src",
    "format:check": "oxfmt src --check",
    "lint": "oxlint ./src",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "coverage": "jest --coverage",
    "unimported": "pnpm knip --directory ../../.. -W domain/api/account-transaction"
  },
  "dependencies": {
    "@domain/api-account-data": "workspace:*",
    "@domain/entity-account-data": "workspace:*",
    "@domain/entity-account-descriptor": "workspace:*",
    "@domain/entity-account-operation": "workspace:*",
    "@domain/entity-account-transaction": "workspace:*"
  },
  "peerDependencies": {
    "@ledgerhq/device-management-kit": "catalog:",
    "rxjs": "catalog:"
  },
  "devDependencies": {
    "@ledgerhq/device-management-kit": "catalog:",
    "@ledgerhq/test-quarantine": "workspace:*",
    "@reduxjs/toolkit": "catalog:",
    "@swc/core": "catalog:",
    "@swc/jest": "catalog:",
    "@types/jest": "catalog:",
    "jest": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "rxjs": "catalog:",
    "typescript": "catalog:"
  }
}
