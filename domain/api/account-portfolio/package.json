{
  "name": "@domain/api-account-portfolio",
  "version": "0.0.0",
  "private": true,
  "description": "Domain API client for the Portfolio service: RTK Query endpoints (portfolio, registrations, balance, updates) with zod wire schemas",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./mock/portfolio-api": "./src/portfolioApi.mock.ts",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "coverage": "jest --coverage",
    "unimported": "pnpm knip --directory ../../.. -W domain/api/account-portfolio"
  },
  "dependencies": {
    "@domain/entity-account-descriptor": "workspace:*",
    "@shared/api-services": "workspace:*",
    "@reduxjs/toolkit": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@jest/globals": "catalog:",
    "@ledgerhq/test-quarantine": "workspace:*",
    "@swc/core": "catalog:",
    "@swc/jest": "catalog:",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "jest": "catalog:",
    "msw": "catalog:",
    "typescript": "catalog:"
  }
}
