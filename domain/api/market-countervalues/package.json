{
  "name": "@domain/api-market-countervalues",
  "version": "0.1.0",
  "private": true,
  "description": "Domain API client for countervalues (Countervalues Service): rate fetching and the loadCountervalues orchestration",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./mock": "./src/mock.ts",
