{
  "name": "@domain/api-ofac",
  "version": "0.0.0",
  "private": true,
  "description": "Domain API client for the OFAC geo-block check on the Countervalues Service: RTK Query endpoint returning blocked true or false",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "coverage": "jest --coverage",
    "unimported": "pnpm knip --directory ../../.. -W domain/api/ofac",
    "format": "oxfmt src",
    "format:check": "oxfmt --check src",
    "lint": "oxlint -c ../../../libs/oxc-live-libs/.oxlintrc.json ./src"
  },
  "dependencies": {
    "@shared/api-services": "workspace:*",
    "@reduxjs/toolkit": "catalog:"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-redux": ">=9.0.0"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@jest/globals": "catalog:",
    "@ledgerhq/test-quarantine": "workspace:*",
    "@swc/core": "catalog:",
    "@swc/jest": "catalog:",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "jest": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "react": "catalog:",
    "react-redux": "catalog:",
    "typescript": "catalog:"
  }
}
