{
  "name": "@domain/api-push-devices",
  "version": "0.2.11",
  "private": true,
  "description": "Domain API client for Push Devices Service: RTK Query mutation and Redux sync middleware",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "lint": "oxlint ./src",
    "format": "oxfmt src",
    "format:check": "oxfmt src --check",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "coverage": "jest --coverage"
  },
  "dependencies": {
    "@shared/api-services": "workspace:*",
    "@domain/entity-client-identity": "workspace:*",
    "@reduxjs/toolkit": "catalog:"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-redux": ">=9.0.0"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@jest/globals": "catalog:",
    "@ledgerhq/test-quarantine": "workspace:*",
    "@swc/core": "catalog:",
    "@swc/jest": "catalog:",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "jest": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "react": "catalog:",
    "react-redux": "catalog:",
    "typescript": "catalog:"
  }
}
