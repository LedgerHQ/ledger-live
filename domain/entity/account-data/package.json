{
  "name": "@domain/entity-account-data",
  "version": "0.1.0",
  "private": true,
  "description": "Account data protocol: the open map of what an account can be asked for, and how a slice receives it",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "format": "oxfmt src",
    "format:check": "oxfmt src --check",
    "lint": "oxlint src",
    "lint:ci": "oxlint src --quiet",
    "lint:fix": "oxfmt src && oxlint src --fix --quiet",
    "typecheck": "tsc --noEmit",
    "unimported": "pnpm knip --directory ../../.. -W domain/entity/account-data"
  },
  "dependencies": {
    "@domain/entity-account": "workspace:^"
  },
  "devDependencies": {
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  }
}
