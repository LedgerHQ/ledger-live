  "devDependencies": {
    "@ledgerhq/test-quarantine": "workspace:*",
    "@support/fmt-base": "workspace:*",
    "@support/jest-domain": "workspace:*",
    "@support/lint-domain": "workspace:*",
    "@support/ts-domain": "workspace:*",
    "@swc/core": "catalog:",
    "@swc/jest": "catalog:",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "jest": "catalog:",
    "oxfmt": "catalog:",
    "typescript": "catalog:"
  }
