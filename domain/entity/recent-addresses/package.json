{
  "name": "@domain/entity-recent-addresses",
  "version": "0.2.1",
  "private": true,
  "description": "RecentAddresses entity: state types, action creators, and wallet-sync module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
