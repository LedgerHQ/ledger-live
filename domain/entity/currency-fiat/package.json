{
  "name": "@domain/entity-currency-fiat",
  "version": "0.4.0",
  "private": true,
  "description": "Domain entity for fiat currencies: Zod schema and registry",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema.mock": "./src/schema.mock.ts",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "coverage": "jest --coverage",
    "unimported": "pnpm knip --directory ../../.. -W domain/entity/currency-fiat",
    "lint": "lint-domain src",
    "lint:fix": "lint-domain src --fix",
    "format": "fmt-base src",
    "format:check": "fmt-base src --check"
  },
  "dependencies": {
    "@domain/entity-currency-unit": "workspace:*",
    "@reduxjs/toolkit": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@jest/globals": "catalog:",
    "@ledgerhq/test-quarantine": "workspace:*",
    "@support/fmt-base": "workspace:*",
    "@support/jest-domain": "workspace:*",
    "@support/lint-domain": "workspace:*",
    "@support/ts-domain": "workspace:*",
    "@swc/core": "catalog:",
    "@swc/jest": "catalog:",
    "@types/jest": "catalog:",
    "jest": "catalog:",
    "typescript": "catalog:"
  }
}
