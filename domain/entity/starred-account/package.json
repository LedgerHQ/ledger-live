{
  "name": "@domain/entity-starred-account",
  "version": "0.0.3",
  "private": true,
  "description": "StarredAccount entity: starred account IDs state, action creators, and selectors",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "lint": "oxlint ./src",
    "format": "oxfmt src",
