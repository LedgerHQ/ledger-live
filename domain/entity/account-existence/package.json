{
  "name": "@domain/entity-account-existence",
  "version": "0.1.0",
  "private": true,
  "description": "Account existence kind: whether an account has any history on chain, asked of the account data sources",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "format": "oxfmt src",
    "format:check": "oxfmt src --check",
    "lint": "oxlint ./src",
    "typecheck": "tsc --noEmit",
    "unimported": "pnpm knip --directory ../../.. -W domain/entity/account-existence"
  },
  "dependencies": {
    "@domain/entity-account-data": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  }
}
