    "unimported": "pnpm knip --directory ../../.. -W domain/entity/client-identity"
  },
  "dependencies": {
    "@reduxjs/toolkit": "catalog:",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@jest/globals": "catalog:",
