{
  "name": "@domain/entity-client-identity",
  "version": "0.1.0",
  "private": true,
  "description": "Domain entity for client identities: DeviceId, UserId, DatadogId value objects and Redux state",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
