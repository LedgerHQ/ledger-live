{
  "name": "@domain/entity-derivation",
  "version": "0.1.0",
  "private": true,
  "description": "Derivation modes of a currency as data: the paths an account scan derives and when it stops",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "format": "oxfmt src",
    "format:check": "oxfmt src --check",
    "lint": "oxlint ./src",
    "typecheck": "tsc --noEmit",
    "unimported": "pnpm knip --directory ../../.. -W domain/entity/derivation"
  },
  "dependencies": {
    "@domain/entity-account-descriptor": "workspace:*",
    "@domain/entity-currency-crypto": "workspace:*"
  },
  "devDependencies": {
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  }
}
