{
  "version": "0.2.0",
  "configurations": [
    {
      // Start LLD with:
      //ELECTRON_ARGS=--remote-debugging-port=8315 pnpm dev:lld
      "name": "Attach Electron Renderer",
      "type": "chrome",
      "request": "attach",
      "port": 8315
    },
    {
      // Start LLD with:
      //LEDGER_INTERNAL_ARGS=--inspect pnpm dev:lld
      "name": "Attach Electron Main",
      "type": "node",
      "request": "attach",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Debug Jest Tests",
      "type": "node",
      "request": "attach",
      "port": 9229
    },
    {
    "name": "e2e mobile android",
    "type": "node",
    "request": "launch",
    "args": ["config/wdio.android.conf.js", "--spec", "${file}"],
    "cwd": "${workspaceFolder}/e2e/poc-wdio",
    "autoAttachChildProcesses": true,
    "program": "${workspaceFolder}/e2e/poc-wdio/node_modules/@wdio/cli/bin/wdio.js",
    "console": "integratedTerminal",
    "skipFiles": [
        "${workspaceFolder}/**/node_modules/**/*.js",
        "${workspaceFolder}/lib/**/*.js",
        "<node_internals>/**/*.js"
      ]
    },
    {
    "name": "e2e mobile ios",
    "type": "node",
    "request": "launch",
    "args": ["config/wdio.ios.conf.js", "--spec", "${file}"],
    "cwd": "${workspaceFolder}/e2e/poc-wdio",
    "autoAttachChildProcesses": true,
    "program": "${workspaceFolder}/e2e/poc-wdio/node_modules/@wdio/cli/bin/wdio.js",
    "console": "integratedTerminal",
    "skipFiles": [
        "${workspaceFolder}/**/node_modules/**/*.js",
        "${workspaceFolder}/lib/**/*.js",
        "<node_internals>/**/*.js"
      ]
    },
  ]
}
