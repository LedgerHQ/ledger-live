{
  "version": "0.2.0",
  "configurations": [
    {
      // Start LLD with:
      //ELECTRON_ARGS=--remote-debugging-port=8315 pnpm dev:lld
      "name": "Attach Electron Renderer",
      "type": "chrome",
      "request": "attach",
      "port": 8315,
      "webRoot": "${workspaceFolder}/apps/ledger-live-desktop",
      "timeout": 30000,
      "resolveSourceMapLocations": ["${workspaceFolder}/**", "!**/node_modules/**"],
      "sourceMapPathOverrides": {
        "webpack://ledger-live-desktop/./*": "${workspaceFolder}/apps/ledger-live-desktop/*",
        "webpack://ledger-live-desktop/../../*": "${workspaceFolder}/*",
        "webpack:///./*": "${workspaceFolder}/apps/ledger-live-desktop/*",
        "webpack:///../../*": "${workspaceFolder}/*",
        "webpack-internal:///./*": "${workspaceFolder}/apps/ledger-live-desktop/*",
        "webpack-internal:///../../*": "${workspaceFolder}/*"
      }
    },
    {
      // Start LLD with:
      //LEDGER_INTERNAL_ARGS=--inspect pnpm dev:lld
      "name": "Attach Electron Main",
      "type": "node",
      "request": "attach",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Debug Jest Tests",
      "type": "node",
      "request": "attach",
      "port": 9229
    },
    {
      // One-click: open a *.test.ts file in libs/ledger-live-common, then run this.
      "name": "Debug LLC Jest (current file)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/libs/ledger-live-common",
      "program": "${workspaceFolder}/libs/ledger-live-common/node_modules/jest/bin/jest.js",
      "args": ["--runInBand", "--watch", "${fileBasenameNoExtension}"],
      "env": { "TZ": "America/New_York" },
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "sourceMaps": true,
      "smartStep": true,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    }
  ]
}
