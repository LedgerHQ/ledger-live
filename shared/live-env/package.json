{
  "name": "@shared/live-env",
  "version": "0.1.0",
  "private": true,
  "description": "Shared live-env definitions organized by team",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "sideEffects": ["./src/index.ts"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "coverage": "jest --coverage",
    "unimported": "pnpm knip --directory ../.. -W shared/live-env"
  },
  "dependencies": {
    "@ledgerhq/live-env": "workspace:*",
    "rxjs": "catalog:"
  },
  "devDependencies": {
    "@jest/globals": "catalog:",
    "@swc/core": "catalog:",
    "@swc/jest": "catalog:",
    "@types/jest": "catalog:",
    "jest": "catalog:",
    "typescript": "catalog:"
  }
}
