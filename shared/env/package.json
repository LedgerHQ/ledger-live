{
  "name": "@shared/env",
  "version": "0.5.0-next.0",
  "private": true,
  "description": "Shared live-env definitions organized by team",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./src/index.ts"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "coverage": "jest --coverage",
    "unimported": "pnpm knip --directory ../.. -W shared/env"
  },
  "dependencies": {
    "@ledgerhq/live-env": "workspace:*"
  },
  "devDependencies": {
    "@jest/globals": "catalog:",
    "@ledgerhq/test-quarantine": "workspace:*",
    "@swc/core": "catalog:",
    "@swc/jest": "catalog:",
    "@types/jest": "catalog:",
    "jest": "catalog:",
    "typescript": "catalog:",
    "@support/jest-shared": "workspace:*"
  }
}
