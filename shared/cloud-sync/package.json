{
  "name": "@shared/cloud-sync",
  "version": "0.3.0",
  "private": true,
  "description": "Cloud sync transport layer: CloudSyncSDK with native fetch and WebSocket transport",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "lint": "oxlint ./src",
    "format": "oxfmt src",
    "format:check": "oxfmt src --check",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "coverage": "jest --coverage"
  },
  "dependencies": {
    "base64-js": "1",
    "isomorphic-ws": "catalog:",
    "pako": "^2.0.4",
    "rxjs": "catalog:",
    "ws": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@jest/globals": "catalog:",
    "@ledgerhq/test-quarantine": "workspace:*",
    "@swc/core": "catalog:",
    "@swc/jest": "catalog:",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "@types/pako": "2.0.3",
    "@types/ws": "8.5.10",
    "@typescript/native": "catalog:",
    "jest": "catalog:",
    "msw": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "@support/jest": "workspace:*"
  }
}
