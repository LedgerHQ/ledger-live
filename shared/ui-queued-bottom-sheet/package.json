{
  "name": "@shared/ui-queued-bottom-sheet",
  "version": "0.2.0",
  "private": true,
  "description": "Shared queue-aware Lumen QueuedBottomSheet for React Native, with app couplings injected as adapters",
  "main": "src/index.ts",
  "react-native": "src/index.native.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.native.ts",
      "default": "./src/index.ts"
    },
    "./keyboard": {
      "react-native": "./src/keyboard.native.ts",
      "default": "./src/keyboard.ts"
    },
    "./testing": "./src/testing/index.ts",
    "./testing/module-mock": "./src/testing/moduleMock.ts",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "format": "oxfmt src",
    "format:check": "oxfmt src --check",
    "typecheck": "tsc --noEmit -p tsconfig.native.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "coverage": "jest --coverage"
  },
  "dependencies": {
    "uuid": "8.3.2"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-native": "catalog:",
    "@gorhom/bottom-sheet": "catalog:",
    "@ledgerhq/lumen-ui-rnative": "catalog:",
    "react-native-safe-area-context": "catalog:"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    },
    "@gorhom/bottom-sheet": {
      "optional": true
    },
    "@ledgerhq/lumen-ui-rnative": {
      "optional": true
    },
    "react-native-safe-area-context": {
      "optional": true
    }
  },
  "devDependencies": {
    "@gorhom/bottom-sheet": "catalog:",
    "@ledgerhq/lumen-ui-rnative": "catalog:",
    "@ledgerhq/test-quarantine": "workspace:*",
    "@swc/core": "catalog:",
    "@swc/jest": "catalog:",
    "@testing-library/react-native": "catalog:",
    "@types/jest": "catalog:",
    "@types/react": "catalog:",
    "@types/uuid": "8.3.4",
    "jest": "catalog:",
    "oxfmt": "catalog:",
    "react": "catalog:",
    "react-native": "catalog:",
    "react-native-safe-area-context": "catalog:",
    "react-test-renderer": "catalog:",
    "typescript": "catalog:",
    "@support/jest-shared": "workspace:*"
  }
}
