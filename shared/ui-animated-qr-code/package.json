    "test": "jest",
    "coverage": "jest --coverage"
  },
  "dependencies": {
    "qrcode": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-native": "catalog:",
    "react-native-reanimated": "catalog:"
  },
  "peerDependenciesMeta": {
