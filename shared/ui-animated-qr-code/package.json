{
  "name": "@shared/ui-animated-qr-code",
  "version": "0.1.0",
  "private": true,
  "description": "QR code drawn and animated natively on iOS and Android: loading shimmer and copy ripple",
  "exports": {
    "./native": "./src/index.native.ts",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "lint": "oxlint ./src",
    "format": "oxfmt src",
