{
  "name": "@shared/schema-primitives",
  "version": "0.5.0",
  "private": true,
  "description": "Reusable Zod schema primitives with no internal dependencies",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "coverage": "jest --coverage",
    "unimported": "pnpm knip --directory ../.. -W shared/schema-primitives",
    "lint": "lint-shared src",
    "lint:fix": "lint-shared src --fix",
    "format": "fmt-base src",
    "format:check": "fmt-base src --check"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@jest/globals": "catalog:",
    "@ledgerhq/test-quarantine": "workspace:*",
    "@support/fmt-base": "workspace:*",
    "@support/jest-shared": "workspace:*",
    "@support/lint-shared": "workspace:*",
    "@support/ts-shared": "workspace:*",
    "@swc/core": "catalog:",
    "@swc/jest": "catalog:",
    "@types/jest": "catalog:",
    "jest": "catalog:",
    "typescript": "catalog:"
  }
}
