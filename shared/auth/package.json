{
  "name": "@shared/auth",
  "version": "0.6.0",
  "private": true,
  "description": "RTK Query authentication helpers",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "lint": "lint-shared src",
    "lint:fix": "lint-shared src --fix",
    "format": "fmt-base ./src",
    "format:check": "fmt-base ./src --check",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "coverage": "jest --coverage",
    "unimported": "pnpm knip --directory ../.. -W shared/auth"
  },
  "dependencies": {
    "@reduxjs/toolkit": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@ledgerhq/test-quarantine": "workspace:*",
    "@support/fmt-base": "workspace:*",
    "@support/jest-shared": "workspace:*",
    "@support/lint-shared": "workspace:*",
    "@support/ts-shared": "workspace:*",
    "@swc/core": "catalog:",
    "@swc/jest": "catalog:",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "jest": "catalog:",
    "msw": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  }
}
