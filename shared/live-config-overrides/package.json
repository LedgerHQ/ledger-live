{
  "name": "@shared/live-config-overrides",
  "version": "0.2.0-next.0",
  "private": true,
  "description": "Local overrides of LiveConfig values: RTK slice, selectors and the middleware that hands them to the host config",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
