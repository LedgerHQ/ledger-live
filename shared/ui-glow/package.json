{
  "name": "@shared/ui-glow",
  "version": "0.1.0",
  "private": true,
  "description": "Animated GPU glow background with grain: a native shader view (Metal on iOS, OpenGL ES on Android)",
  "exports": {
    "./native": "./src/native/index.native.ts",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "lint": "oxlint ./src",
    "format": "oxfmt src",
    "format:check": "oxfmt src --check",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "coverage": "jest --coverage"
  },
  "codegenConfig": {
    "name": "SharedUiGlowSpec",
    "type": "components",
    "jsSrcsDir": "./src/native/specs",
    "android": {
      "javaPackageName": "com.ledger.uiglow"
    },
    "ios": {
      "componentProvider": {
        "GlowView": "RCTGlowView"
      }
    }
  },
  "devDependencies": {
    "@ledgerhq/test-quarantine": "workspace:*",
    "@support/jest": "workspace:*",
    "@swc/core": "catalog:",
    "@swc/jest": "catalog:",
    "@testing-library/react-native": "catalog:",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@typescript/native": "catalog:",
    "jest": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "react": "catalog:",
    "react-native": "catalog:",
    "react-test-renderer": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-native": "catalog:"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  }
}
