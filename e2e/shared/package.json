{
  "name": "@ledgerhq/live-e2e-shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "@ledgerhq/source": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./commands": {
      "types": "./src/commands-entry.ts",
      "default": "./lib/commands.cjs"
    }
  },
  "scripts": {
    "build:e2e": "node scripts/build-bundle.mjs",
    "typecheck": "tsc --noEmit --project tsconfig.json --customConditions node",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check"
  },
  "dependencies": {
    "@ledgerhq/ledger-wallet-framework": "workspace:^",
    "@ledgerhq/live-common": "workspace:^",
    "@ledgerhq/live-dmk-speculos": "workspace:^",
    "@ledgerhq/live-env": "workspace:^",
    "@ledgerhq/types-live": "workspace:^",
    "esbuild": "0.25.5",
    "invariant": "^2.2.4"
  },
  "devDependencies": {
    "@types/invariant": "^2.2.36"
  }
}
