{
  "name": "poc-wdio",
  "devDependencies": {
    "@ledgerhq/ledger-key-ring-protocol": "workspace:^",
    "@ledgerhq/live-common": "workspace:^",
    "@ledgerhq/live-dmk-speculos": "workspace:^",
    "@ledgerhq/live-env": "workspace:^",
    "@ledgerhq/live-wallet": "workspace:^",
    "@ledgerhq/types-live": "workspace:^",
    "@shared/feature-flags": "workspace:*",
    "@types/node": "catalog:",
    "@wdio/allure-reporter": "9.27.1",
    "@wdio/appium-service": "9.27.1",
    "@wdio/cli": "9.27.1",
    "@wdio/globals": "9.27.1",
    "@wdio/local-runner": "9.27.1",
    "@wdio/logger": "9.18.0",
    "@wdio/mocha-framework": "9.27.1",
    "@wdio/spec-reporter": "9.27.1",
    "allure-commandline": "2.28.0",
    "appium": "3.5.0",
    "appium-uiautomator2-driver": "7.5.2",
    "appium-xcuitest-driver": "11.3.0",
    "expect-webdriverio": "5.6.5",
    "rxjs": "catalog:",
    "typescript": "catalog:",
    "uuid": "14.0.0",
    "wdio-video-reporter": "6.2.0",
    "webdriverio": "9.27.1",
    "ws": "catalog:"
  },
  "scripts": {
    "allure:generate": "allure generate ./artifacts --clean -o ./artifacts/allure-report",
    "allure:open": "allure open ./artifacts/allure-report",
    "allure": "pnpm run allure:generate && pnpm run allure:open",
    "android": "wdio run ./config/wdio.android.conf.ts",
    "ios": "wdio run ./config/wdio.ios.conf.ts",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  }
}
