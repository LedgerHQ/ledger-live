{
  "name": "ledger-live-mobile-e2e-tests",
  "targets": {
    "build-e2e-deps": {
      "executor": "nx:noop",
      "dependsOn": ["^build"]
    },
    "test:ci": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "cache": false,
      "options": {
        "command": "pnpm test:ci",
        "cwd": "{projectRoot}",
        "forwardAllArgs": true
      }
    }
  }
}
