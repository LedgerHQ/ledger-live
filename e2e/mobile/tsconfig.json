{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "noImplicitAny": false,
    "noEmit": true,
    "experimentalDecorators": true,
    "types": ["node", "jest"],
    "paths": {
      "@e2e/*": ["./*"]
    }
  },
  "include": ["./types", "./**/*.ts"],
  "exclude": ["**/node_modules/**", "**/*.js"]
}
