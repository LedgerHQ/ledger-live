{
  "name": "ledger-live-mobile-e2e-tests",
  "version": "0.41.0",
  "private": true,
  "scripts": {
    "lint": "oxlint .",
    "lint:test-names": "node ./scripts/check-test-names.mjs",
    "lint:fix": "oxfmt . && oxlint . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "typecheck": "node ./scripts/typecheck.js",
    "test:detox": "pnpm detox test",
    "test:ios": "pnpm test:detox --configuration ios.sim.release",
    "test:android": "pnpm test:detox --configuration android.emu.release",
    "build:ios": "nx run live-mobile:e2e:build -- --configuration ios.sim.release",
    "build:android": "nx run live-mobile:e2e:build -- --configuration android.emu.release",
    "test:ios:debug": "pnpm test:detox --configuration ios.sim.debug",
    "test:android:debug": "pnpm test:detox --configuration android.emu.debug",
    "build:ios:debug": "pnpm --filter live-mobile run e2e:build --configuration ios.sim.debug",
    "build:android:debug": "pnpm --filter live-mobile run e2e:build --configuration android.emu.debug",
    "allure:generate": "allure generate ./artifacts --clean -o ./artifacts/allure-report",
    "allure:open": "allure open ./artifacts/allure-report",
    "allure": "pnpm run allure:generate && pnpm run allure:open"
  },
  "dependencies": {
    "@ledgerhq/logs": "catalog:",
    "axios": "catalog:",
    "invariant": "2.2.4",
    "rxjs": "catalog:",
    "uuid": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@domain/entity-contact": "workspace:^",
    "@domain/entity-currency-crypto": "workspace:^",
    "@jest/reporters": "catalog:",
    "@jest/types": "^30.2.0",
    "@ledgerhq/devices": "catalog:",
    "@shared/feature-flags": "workspace:*",
    "@shared/env": "workspace:*",
    "@ledgerhq/hw-transport": "catalog:",
    "@ledgerhq/ledger-key-ring-protocol": "catalog:",
    "@ledgerhq/live-common": "workspace:^",
    "@ledgerhq/live-dmk-speculos": "workspace:^",
    "@ledgerhq/live-e2e-shared": "workspace:^",
    "@ledgerhq/baanx-test-client": "workspace:^",
    "@shared/cloud-sync": "workspace:^",
    "@features/platform-wallet-sync": "workspace:^",
    "@ledgerhq/live-wallet": "workspace:^",
    "@ledgerhq/test-utils": "workspace:^",
    "@ledgerhq/types-devices": "workspace:^",
    "@ledgerhq/types-live": "workspace:^",
    "@types/body-parser": "1.19.5",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/invariant": "2.2.37",
    "@types/node": "catalog:",
    "@types/jest": "catalog:",
    "@types/lodash": "catalog:",
    "@types/ws": "8.5.10",
    "allure-commandline": "2.28.0",
    "bignumber.js": "9.1.2",
    "body-parser": "2.2.2",
    "cors": "2.8.5",
    "detox": "catalog:",
    "detox-allure2-adapter": "1.0.0-alpha.42",
    "expect": "catalog:",
    "express": "5.2.1",
    "glob": "^11.0.1",
    "jest": "catalog:",
    "jest-allure2-reporter": "2.2.8",
    "jest-docblock": "catalog:",
    "jest-environment-node": "catalog:",
    "jest-metadata": "1.6.0",
    "lodash": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "@swc/jest": "catalog:",
    "@swc/core": "catalog:",
    "ts-node": "10.9.2",
    "tsconfig-paths": "^4.2.0",
    "ws": "catalog:"
  }
}
