{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "esModuleInterop": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "types": ["jest", "detox", "node"]
  },
  "include": ["bridge/**/*", "helpers/**/*", "pages/**/*", "e2e/**/*", ".detoxrc.js"]
}
