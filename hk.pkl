amends "package://github.com/jdx/hk/releases/download/v1.40.0/hk@1.40.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.40.0/hk@1.40.0#/Builtins.pkl"

hooks {
    ["pre-commit"] {
        steps {
            ["oxfmt"] {
                glob = List("*.ts", "*.tsx", "*.js", "*.jsx", "*.mjs", "*.cjs")
                stage = List("*.ts", "*.tsx", "*.js", "*.jsx", "*.mjs", "*.cjs")
                check = "oxfmt --check {{ files }}"
                fix = "oxfmt {{ files }}"
            }
            ["gitleaks"] {
                check = "gitleaks git --pre-commit --staged --redact --no-banner --verbose --config .gitleaks.toml"
            }
            ["dependency-checks"] {
                glob = List("pnpm-lock.yaml", "tools/danger/dependency-checks/**")
                check = "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/danger/dependency-checks/cli.ts"
            }
            ["actionlint"] = Builtins.actionlint
            ["zizmor"] = (Builtins.zizmor) {
                glob = List(".github/workflows/*.yml", "tools/actions/**/*.yml")
                check = "zizmor --no-progress {{ files }} --min-severity=high"
            }
        }
    }
    ["commit-msg"] {
        steps {
            ["commitlint"] {
                check = "pnpm commitlint --edit {{ commit_msg_file }}"
            }
        }
    }
}
