# No private hoist. Public hoist is empty by default here, then we add
# back only packages CI cannot resolve without a root symlink.
# pnpm's own default is hoist=true plus *eslint* and *prettier*.
hoist=false
public-hoist-pattern[]=react-native
public-hoist-pattern[]=@types/react
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=tailwindcss
public-hoist-pattern[]=@babel/*

# Peer defaults (auto-install-peers / dedupe-peer-dependents) multiply
# react-native and suffix virtual-store folders. Desktop aliases and Jest
# assume one unsuffixed copy, and CI's JFrog action also forces
# auto-install-peers=false. Keep both flags off for this hoist trial.
auto-install-peers=false
dedupe-peer-dependents=false

# Workaround for Prefab 2.1.0 / Clikt bug splitting paths at '='
# See: https://github.com/google/prefab/issues/187
virtual-store-dir-max-length=80

save-exact=true
