  "name": "enforce-tool-config",
  "projectType": "library",
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["{workspaceRoot}/tools/nx-plugins/enforce-tool-config/**/*"],
      "options": {
