        "command": "node --test tools/nx-plugins/enforce-tool-config/plugin.test.mjs tools/nx-plugins/enforce-tool-config/validate.test.mjs tools/nx-plugins/enforce-tool-config/rules/fmt.test.mjs tools/nx-plugins/enforce-tool-config/rules/lint.test.mjs"
      }
    }
  }
}
