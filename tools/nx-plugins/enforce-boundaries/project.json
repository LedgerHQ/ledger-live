{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "enforce-boundaries",
  "projectType": "library",
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/tools/nx-plugins/enforce-boundaries/**/*",
        "{workspaceRoot}/.agents/skills/devtools-import-boundary/SKILL.md"
      ],
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "node --test tools/nx-plugins/enforce-boundaries/validate.test.js"
      }
    },
    "lint:boundaries": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/tools/nx-plugins/enforce-boundaries/**/*",
        "{workspaceRoot}/tools/nx-plugins/project-tags/plugin.js",
        "{workspaceRoot}/{domain,shared,features,support,devtools}/**/package.json",
        "{workspaceRoot}/{domain,shared,features,support,devtools}/**/*.@(ts|tsx|js|jsx|mjs|cjs)",
        "!{workspaceRoot}/{domain,shared,features,support,devtools}/**/@(node_modules|dist|lib|build|.turbo|.cache)/**",
        "{workspaceRoot}/{apps,libs}/**/package.json",
        "{workspaceRoot}/pnpm-workspace.yaml",
        "{workspaceRoot}/nx.cache-config.json"
      ],
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "node tools/nx-plugins/enforce-boundaries/validate.js"
      }
    }
  }
}
