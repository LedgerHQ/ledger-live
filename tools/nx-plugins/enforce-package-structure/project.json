{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "enforce-package-structure",
  "projectType": "library",
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/tools/nx-plugins/enforce-package-structure/**/*",
        "{workspaceRoot}/domain/**/package.json",
        "{workspaceRoot}/domain/**/*.ts",
        "{workspaceRoot}/domain/**/*.tsx",
        "{workspaceRoot}/domain/**/*.js",
        "{workspaceRoot}/domain/**/*.jsx",
        "{workspaceRoot}/domain/**/*.mts",
        "{workspaceRoot}/domain/**/*.cts",
        "{workspaceRoot}/domain/**/*.mjs",
        "{workspaceRoot}/domain/**/*.cjs",
        "!{workspaceRoot}/domain/**/node_modules/**",
        "!{workspaceRoot}/domain/**/dist/**",
        "!{workspaceRoot}/domain/**/lib/**",
        "!{workspaceRoot}/domain/**/lib-es/**",
        "!{workspaceRoot}/domain/**/build/**",
        "!{workspaceRoot}/domain/**/.turbo/**",
        "!{workspaceRoot}/domain/**/.cache/**",
        "{workspaceRoot}/shared/**/package.json",
        "{workspaceRoot}/shared/**/*.ts",
        "{workspaceRoot}/shared/**/*.tsx",
        "{workspaceRoot}/shared/**/*.js",
        "{workspaceRoot}/shared/**/*.jsx",
        "{workspaceRoot}/shared/**/*.mts",
        "{workspaceRoot}/shared/**/*.cts",
        "{workspaceRoot}/shared/**/*.mjs",
        "{workspaceRoot}/shared/**/*.cjs",
        "!{workspaceRoot}/shared/**/node_modules/**",
        "!{workspaceRoot}/shared/**/dist/**",
        "!{workspaceRoot}/shared/**/lib/**",
        "!{workspaceRoot}/shared/**/lib-es/**",
        "!{workspaceRoot}/shared/**/build/**",
        "!{workspaceRoot}/shared/**/.turbo/**",
        "!{workspaceRoot}/shared/**/.cache/**",
        "{workspaceRoot}/features/**/package.json",
        "{workspaceRoot}/features/**/*.ts",
        "{workspaceRoot}/features/**/*.tsx",
        "{workspaceRoot}/features/**/*.js",
        "{workspaceRoot}/features/**/*.jsx",
        "{workspaceRoot}/features/**/*.mts",
        "{workspaceRoot}/features/**/*.cts",
        "{workspaceRoot}/features/**/*.mjs",
        "{workspaceRoot}/features/**/*.cjs",
        "!{workspaceRoot}/features/**/node_modules/**",
        "!{workspaceRoot}/features/**/dist/**",
        "!{workspaceRoot}/features/**/lib/**",
        "!{workspaceRoot}/features/**/lib-es/**",
        "!{workspaceRoot}/features/**/build/**",
        "!{workspaceRoot}/features/**/.turbo/**",
        "!{workspaceRoot}/features/**/.cache/**"
      ],
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "node --test tools/nx-plugins/enforce-package-structure/*.test.js"
      }
    }
  }
}
