{
  "$schema": "./components.config.schema.json",
  "ignoredEntryPrefixes": ["test", "mock"],
  "platformEntries": {
    "./web": "web",
    "./native": "native"
  },
  "conditions": {
    "web": ["default"],
    "native": ["react-native", "default"]
  },
  "extensions": {
    "web": [".web.tsx", ".web.ts", ".tsx", ".ts", ".js", ".jsx"],
    "native": [
      ".ios.js",
      ".android.js",
      ".native.js",
      ".js",
      ".ios.jsx",
      ".android.jsx",
      ".native.jsx",
      ".jsx",
      ".ios.ts",
      ".android.ts",
      ".native.ts",
      ".ts",
      ".ios.tsx",
      ".android.tsx",
      ".native.tsx",
      ".tsx"
    ]
  },
  "componentWrappers": ["memo", "forwardRef"]
}
