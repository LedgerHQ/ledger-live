{
  "$schema": "./components.config.schema.json",
  "ignoredEntryPrefixes": ["test", "mock"],
  "platformEntries": {
    "./web": "web",
    "./native": "native"
  },
  "conditions": {
    "web": ["default"],
    "native": ["react-native", "default"]
  },
  "extensions": {
    "web": [".web.tsx", ".web.ts", ".tsx", ".ts", ".js", ".jsx"],
    "native": [
      ".ios.js",
      ".android.js",
      ".native.js",
      ".js",
      ".ios.jsx",
      ".android.jsx",
      ".native.jsx",
      ".jsx",
      ".ios.ts",
      ".android.ts",
      ".native.ts",
      ".ts",
      ".ios.tsx",
      ".android.tsx",
      ".native.tsx",
      ".tsx"
    ]
  },
  "componentWrappers": ["memo", "forwardRef"],
  "bannedImportPrefixes": ["react-native", "@ledgerhq/lumen-ui-", "react-dom"],
  "bannedTypeNames": [
    "ChangeEvent",
    "SyntheticEvent",
    "BaseSyntheticEvent",
    "MouseEvent",
    "KeyboardEvent",
    "FocusEvent",
    "FormEvent",
    "PointerEvent",
    "TouchEvent",
    "DragEvent",
    "WheelEvent",
    "UIEvent",
    "ClipboardEvent",
    "CompositionEvent",
    "AnimationEvent",
    "TransitionEvent",
    "*EventHandler",
    "CSSProperties",
    "*HTMLAttributes",
    "HTMLProps",
    "DetailedHTMLProps",
    "HTML*Element",
    "SVG*Element",
    "NativeSyntheticEvent",
    "GestureResponderEvent",
    "LayoutChangeEvent",
    "NativeScrollEvent",
    "StyleProp",
    "ViewStyle",
    "TextStyle",
    "ImageStyle",
    "ImageSourcePropType"
  ],
  "bannedPropNames": ["className", "style"],
  "gestureWords": ["Click", "Press", "Tap", "Touch", "Mouse", "Pointer"],
  "bannedCallbackNames": ["onChange", "onChangeText", "onSubmit", "onFocus", "onBlur", "onKey*"]
}
