# Android AVD used by the mobile E2E tests: the one place it is configured.
# Read through avd-config.sh, which also derives AVD_CACHE_KEY. Values are not quoted:
# avd-config.sh's output goes straight into $GITHUB_ENV / $GITHUB_OUTPUT.
# The runner image (ledger-wallet-runners) bakes this AVD in from develop, weekly.
AVD_API=36
AVD_ARCH=x86_64
AVD_PROFILE=pixel_9_pro
AVD_TARGET=google_apis
AVD_NAME=Android_Emulator
AVD_CORES=2
AVD_RAM_SIZE=4096
AVD_HEAP_SIZE=1024
# Emulator 37.2.12.0
AVD_EMULATOR_BUILD=16428233
AVD_LCD_WIDTH=854
AVD_LCD_HEIGHT=1904
AVD_LCD_DENSITY=320
AVD_OPTIONS=-no-window -gpu swiftshader -accel on -no-audio -no-boot-anim -camera-back none -camera-front none -no-metrics
