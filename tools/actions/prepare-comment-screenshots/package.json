{
  "name": "@actions/prepare-comment-screenshots",
  "version": "1.2.0",
  "description": "returns a formatted comment to be added to the PR",
  "author": "Valentin D. Pinkman <valentin.d.pinkman@icloud.com>",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "rslib build",
    "lint": "oxlint ./",
    "lint:fix": "oxlint ./ --fix",
    "format": "fmt-base . '!**/build/**'",
    "format:check": "fmt-base . '!**/build/**' --check"
  },
  "devDependencies": {
    "@actions/core": "1.10.1",
    "@actions/github": "6.0.0",
    "@rslib/core": "catalog:",
    "@support/fmt-base": "workspace:*"
  }
}
