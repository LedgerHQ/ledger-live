{
  "name": "@actions/submit-bot-report",
  "version": "1.5.0",
  "description": "Use the bot report to upload to all relevant places (Github comment, Slack)",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "rslib build",
    "lint": "lint-tools ./",
    "lint:fix": "lint-tools ./ --fix",
    "format": "fmt-base . '!**/build/**'",
    "format:check": "fmt-base . '!**/build/**' --check"
  },
  "devDependencies": {
    "@actions/core": "1.10.1",
    "@actions/github": "6.0.0",
    "@rslib/core": "catalog:",
    "@support/fmt-base": "workspace:*",
    "@support/lint-tools": "workspace:*",
    "node-fetch": "3.3.2"
  }
}
